diff --git a/libs/UtilitiesLib/include/utilitieslib/utils/armport_zone_trace.h b/libs/UtilitiesLib/include/utilitieslib/utils/armport_zone_trace.h
new file mode 100644
index 0000000..7dce587
--- /dev/null
+++ b/libs/UtilitiesLib/include/utilitieslib/utils/armport_zone_trace.h
@@ -0,0 +1,16 @@
+#pragma once
+
+// ArmPort diagnostics only. No packet, loading or timeout behavior changes.
+#if defined(__aarch64__) && defined(__MINGW32__)
+#include <stdio.h>
+#include <stdlib.h>
+#include <utilitieslib/utils/wininclude.h>
+static void armportZoneTrace(const char *stage, const char *detail)
+{
+    if (getenv("ARMPORT_STDIO_LOG"))
+        fprintf(stderr, "ArmPort zone: %lu %s %.240s\n",
+                (unsigned long)GetTickCount(), stage, detail ? detail : "");
+}
+#else
+#define armportZoneTrace(stage, detail) ((void)0)
+#endif
