+static int armportZoneTraceQuietDrops(const char *stage)
+{
+    /* ARMPORT_TRACE_QUIET (device play): keep only load boundaries, errors
+     * and dialogs. Per-file library/texture/model records cost load time on
+     * the Thor and are only needed by CI qualification, which leaves it unset. */
+    static int quiet = -1;
+    static const char *const keep[] = {"map.start", "textures.done", "ready.sent",
+        "client.error", "client.fatal", "dialog."};
+    size_t i;
+    if (quiet < 0) quiet = getenv("ARMPORT_TRACE_QUIET") != NULL;
+    if (!quiet) return 0;
+    for (i = 0; i < sizeof(keep) / sizeof(keep[0]); ++i)
+        if (!strncmp(stage, keep[i], strlen(keep[i]))) return 0;
+    return 1;
+}
+
