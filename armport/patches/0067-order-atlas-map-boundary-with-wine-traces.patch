+                FILE_ATTRIBUTE_NORMAL, NULL) : INVALID_HANDLE_VALUE;
+            int ok = file != INVALID_HANDLE_VALUE &&
+                WriteFile(file, marker, sizeof(marker) - 1, &written, NULL) && written == sizeof(marker) - 1;
+            if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+            if (!ok) fprintf(stderr, "ARMPORT_ZONE_LOG_FAILED\n");
+        }
+    }
     armportZoneTraceFile(stage, detail);
