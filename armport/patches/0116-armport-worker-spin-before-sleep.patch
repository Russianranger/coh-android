diff --git a/Game/src/graphics/armport_frame_rate_log.h b/Game/src/graphics/armport_frame_rate_log.h
index 53e6b9f..e9b2344 100644
--- a/Game/src/graphics/armport_frame_rate_log.h
+++ b/Game/src/graphics/armport_frame_rate_log.h
@@ -5,6 +5,10 @@
  */
 #ifndef ARMPORT_FRAME_RATE_LOG_H
 #define ARMPORT_FRAME_RATE_LOG_H
+#include "utilitieslib/utils/wininclude.h"
+/* Worker-thread wakeup counters (WorkerThread.c, patch 0116): all worker
+ * threads, cumulative; workers update them atomically, so read them atomically. */
+extern long armport_wt_sleeps, armport_wt_spin_hits;
 #pragma push_macro("printf")
 #pragma push_macro("snprintf")
 #pragma push_macro("fflush")
@@ -38,6 +42,49 @@ static void armportFrameRateLogWrite(float fps, int frames, float seconds, int m
     fflush(stdout);
 }
 
+typedef struct ArmportWorkerSample
+{
+    long sleeps, spin_hits;
+    unsigned long long user_100ns, kernel_100ns;
+} ArmportWorkerSample;
+
+static void armportWorkerSample(ArmportWorkerSample *sample)
+{
+    FILETIME created, exited, kernel, user;
+    sample->sleeps = __atomic_load_n(&armport_wt_sleeps, __ATOMIC_RELAXED);
+    sample->spin_hits = __atomic_load_n(&armport_wt_spin_hits, __ATOMIC_RELAXED);
+    sample->user_100ns = sample->kernel_100ns = 0;
+    if (GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user)) {
+        sample->user_100ns = ((unsigned long long)user.dwHighDateTime << 32) | user.dwLowDateTime;
+        sample->kernel_100ns = ((unsigned long long)kernel.dwHighDateTime << 32) | kernel.dwLowDateTime;
+    }
+}
+
+static ArmportWorkerSample armport_worker_since;
+
+/* Start (or restart) the window that armportWorkerLogWrite reports. */
+static void armportWorkerLogStart(void)
+{
+    armportWorkerSample(&armport_worker_since);
+}
+
+/* Patch 0116: worker sleeps vs spin hits and the client's CPU time over the
+ * same window as the ARMPORT_FRAME_RATE_V1 line just written. */
+static void armportWorkerLogWrite(float seconds)
+{
+    char line[200];
+    ArmportWorkerSample now;
+    armportWorkerSample(&now);
+    snprintf(line, sizeof(line),
+        "ARMPORT_WORKER_V1 seconds=%.2f worker_sleeps=%ld worker_spin_hits=%ld cpu_user_ms=%llu cpu_kernel_ms=%llu\n",
+        seconds, now.sleeps - armport_worker_since.sleeps, now.spin_hits - armport_worker_since.spin_hits,
+        (now.user_100ns - armport_worker_since.user_100ns) / 10000,
+        (now.kernel_100ns - armport_worker_since.kernel_100ns) / 10000);
+    fputs(line, stdout);
+    fflush(stdout);
+    armport_worker_since = now;
+}
+
 #pragma pop_macro("FILE")
 #pragma pop_macro("fputs")
 #pragma pop_macro("fflush")
