             }
diff --git a/libs/UtilitiesLib/src/components/WorkerThread.c b/libs/UtilitiesLib/src/components/WorkerThread.c
index 2b42bfd..54e3a4a 100644
--- a/libs/UtilitiesLib/src/components/WorkerThread.c
+++ b/libs/UtilitiesLib/src/components/WorkerThread.c
@@ -21,6 +21,20 @@
 
 static void wtDispatchMessages(WorkerThread *wt);
 
+// ArmPort (patch 0116): under Wine 10 in PRoot every ResetEvent, SetEvent and
+// WaitForSingleObject is a traced wineserver round trip. A worker that sleeps
+// whenever its queue drains pays up to three round trips per queued render
+// command. On ARM64 it first polls the (atomically published, patch 0050)
+// queue for up to ARMPORT_WT_SPIN_US; it sleeps only when no work arrives.
+// thread_asleep stays 0 while polling, so producers do not signal.
+#if defined(__aarch64__) && defined(__MINGW32__)
+#define ARMPORT_WT_SPIN_US 2000
+#endif
+// Process-wide totals over all workers, read live by the frame-rate log:
+// every access is atomic (relaxed: counts only, no ordering implied).
+long armport_wt_sleeps, armport_wt_spin_hits;
+#define ARMPORT_WT_COUNT(counter) __atomic_fetch_add(&(counter), 1, __ATOMIC_RELAXED)
+
 #ifdef _M_X64
 #    pragma warning(push)
 #    pragma warning(disable:4324)
@@ -349,7 +363,14 @@ static unsigned __stdcall wtThread( LPVOID lpParam )
     WorkerThread *wt;
     QueuedCmd *cmd,last;
 
+#ifdef ARMPORT_WT_SPIN_US
+    LARGE_INTEGER frequency; // per worker, set before the loop
+#endif
+
     wt = (WorkerThread *)lpParam;
+#ifdef ARMPORT_WT_SPIN_US
+    QueryPerformanceFrequency(&frequency);
+#endif
     wt->thread_id = (int)GetCurrentThreadId();
     wt->data_queued = CreateEvent(0,0,0,0);
     wtSharedStore(wt->thread_state, THREAD_RUNNING);
@@ -372,6 +393,31 @@ static unsigned __stdcall wtThread( LPVOID lpParam )
             cmd = peekStoredCmd(&wt->cmd_queue);
         if (!cmd)
         {
+#ifdef ARMPORT_WT_SPIN_US
+            if (wt->data_queued && !(wt->debug && !wt->flush_requested && wt->run_threaded))
+            {
+                LARGE_INTEGER started, now;
+                int spins = 0;
+                QueryPerformanceCounter(&started);
+                while (!(cmd = peekStoredCmd(&wt->cmd_queue))
+                       && wtSharedLoad(wt->thread_state) != THREAD_TOLDTOEXIT)
+                {
+                    YieldProcessor();
+                    if ((++spins & 63) == 0)
+                    {
+                        QueryPerformanceCounter(&now);
+                        if ((now.QuadPart - started.QuadPart) * 1000000
+                                >= frequency.QuadPart * ARMPORT_WT_SPIN_US)
+                            break;
+                    }
+                }
+                if (cmd)
+                {
+                    ARMPORT_WT_COUNT(armport_wt_spin_hits);
+                    continue;
+                }
+            }
+#endif
             if (wt->data_queued)
             {
                 // Arm before the final empty check: a producer after that
@@ -380,6 +426,7 @@ static unsigned __stdcall wtThread( LPVOID lpParam )
                 ResetEvent(wt->data_queued);
                 cmd = peekStoredCmd(&wt->cmd_queue);
                 if (!cmd) {
+                    ARMPORT_WT_COUNT(armport_wt_sleeps);
                     WaitForSingleObject(wt->data_queued, INFINITE);
                 }
                 wtSharedStore(wt->thread_asleep, 0);
