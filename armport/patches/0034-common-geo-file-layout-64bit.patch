+#if defined(_WIN64)
+/* ArmPort: .geo files store 32-bit structures. Sizes on disk: */
+#define GEO_FILE_MODELHEADER_SIZE   140 /* name[124], model_data, length, models, model_count */
+#define GEO_FILE_POLYGRID_SIZE      32  /* cell, pos, size, inv_size, tag, num_bits */
+#define GEO_FILE_PACKDATA_SIZE      12  /* packsize, unpacksize, data */
+#define GEO_FILE_POLYCELL_SIZE      12  /* children, tri_idxs, tri_count */
+
+/* Collision cells on disk are 32-bit (offsets from the first cell, 8 child
+ * offsets per children array). Rebuild them as native cells in front of the
+ * raw data (in the same allocation, which modelFreeCtris frees). Native cells
+ * take at most twice the raw bytes. */
+#define GEO_POLYCELL_NATIVE_RESERVE(unpacksize) ((((size_t)(unpacksize) * 2) + 31) & ~(size_t)15)
+
+typedef struct PolyCellBuild
+{
+    const U8    *raw;
+    U32         raw_size;
+    U8          *out;
+    size_t      used, cap;
+    Model       *model;
+} PolyCellBuild;
+
+static void *polyCellBuildAlloc(PolyCellBuild *b, size_t n)
+{
+    void *p;
+    n = (n + 7) & ~(size_t)7;
+    assert(b->used + n <= b->cap);
+    p = b->out + b->used;
+    b->used += n;
+    return p;
+}
+
+static PolyCell *polyCellBuildCell(PolyCellBuild *b, U32 off, PolyCell *dst)
+{
+    U32 children, tris;
+    int count, i;
+
+    assert(off <= b->raw_size && b->raw_size - off >= GEO_FILE_POLYCELL_SIZE);
+    memcpy(&children, b->raw + off, 4);
+    memcpy(&tris, b->raw + off + 4, 4);
+    memcpy(&count, b->raw + off + 8, 4);
+    if (!dst)
+        dst = polyCellBuildAlloc(b, sizeof(PolyCell));
+    dst->tri_count = count;
+    dst->tri_idxs = tris ? (U16 *)(b->raw + tris) : NULL;
+    assert(!tris || (tris <= b->raw_size && (b->raw_size - tris) / 2 >= (U32)count));
+    for (i = 0; i < count; i++)
+        assert(dst->tri_idxs[i] < b->model->tri_count);
+    dst->children = NULL;
+    if (children)
+    {
+        U32 kids[8];
+        assert(children <= b->raw_size && b->raw_size - children >= sizeof(kids));
+        memcpy(kids, b->raw + children, sizeof(kids));
+        dst->children = polyCellBuildAlloc(b, 8 * sizeof(PolyCell *));
+        for (i = 0; i < 8; i++)
+            dst->children[i] = kids[i] ? polyCellBuildCell(b, kids[i], NULL) : NULL;
+    }
+    return dst;
+}
+
+static PolyCell *polyCellUnpackFile(Model *model, const U8 *raw, U32 raw_size, void *out, size_t cap)
+{
+    PolyCellBuild b = { raw, raw_size, out, 0, cap, model };
+    PolyCell *root = polyCellBuildAlloc(&b, sizeof(PolyCell));
+    return polyCellBuildCell(&b, 0, root);
+}
+
+/* BoneInfo on disk ends in two 32-bit pointer slots; keep a native copy and
+ * the file offset (for restoreStubOffsets). */
+typedef struct ArmPortBoneInfo
+{
+    Model       *model;
+    uintptr_t   file_offset;
+    BoneInfo    bi;
+} ArmPortBoneInfo;
+
+/* Frees the BoneInfo copies geoLoadData made for this gld. A model still
+ * pointing at its copy gets the file offset back (restoreStubOffsets needs
+ * it); the client may have replaced boneinfo with a dummy, which is left. */
+static void armportFreeBoneInfos(GeoLoadData *gld)
+{
+    int i;
+    for (i = 0; i < eaSize(&gld->armport_boneinfos); i++)
+    {
+        ArmPortBoneInfo *abi = gld->armport_boneinfos[i];
+        if (abi->model->boneinfo == &abi->bi)
+            abi->model->boneinfo = (void *)abi->file_offset;
+        free(abi);
+    }
+    eaDestroy(&gld->armport_boneinfos);
+}
