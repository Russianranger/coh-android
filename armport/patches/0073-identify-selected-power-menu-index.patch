+// 0073: identify the selected-power producer for the runtime fault.
+// Opt-in diagnostics only: retain the original index, pointer and lookup.
+static void armportSelectedPowerTrace(const char *site, int menu, const BasePower *selected,
+                                     const BasePower *argument)
+{
+    static int traceEnabled = -1;
+    char detail[224];
+    if (traceEnabled < 0)
+        traceEnabled = getenv("ARMPORT_POWER_TRACE") != NULL;
+    if (!traceEnabled)
+        return;
+    snprintf(detail, sizeof(detail), "site=%s menu=%d index=%d count=%d array=%p selected=%p argument=%p",
+        site, menu, menu - MENU_POWER_CUST, POWERCUSTSET_COUNT,
+        (void *)sSelectedPowers, (const void *)selected, (const void *)argument);
+    armportZoneTrace("power.selected", detail);
+}
