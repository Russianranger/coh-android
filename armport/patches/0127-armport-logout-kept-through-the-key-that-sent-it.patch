+static U32 inp_edge_times[256];
 KeyInput textKeyboardBuffer[64];
 U32 gDoubleClickTime = 0;
 
@@ -374,6 +377,15 @@ int inpEdge(int idx)
     }
 }
 
+// ArmPort: when the press behind key idx's current edge happened. Wine's
+// DirectInput keyboard hook queues a press while the window messages are
+// pumped (windowProcessMessages, after this frame's inpUpdate), so the edge can
+// come one frame after the WM_KEYDOWN that the chat window already acted on.
+U32 inpEdgeTime(int idx)
+{
+    return (idx >= 0 && idx < 256) ? inp_edge_times[idx] : 0;
+}
+
 bool inpEdgeNoTextEntry(int idx)
 {
     return (uiNoOneHasFocus() && inpEdge(idx));
@@ -1436,9 +1448,11 @@ void inpUpdateKeyEx(int keyIndex, int keyState, int timeStamp, int x, int y )
         if(!inp_levels[keyIndex])
         {
             inp_edges[keyIndex] = 1;
+            inp_edge_times[keyIndex] = timeStamp;
         } else if (just_lost_focus_debug) {
             // We missed the up event because of our debugger hack
             inp_edges[keyIndex] = 1;
+            inp_edge_times[keyIndex] = timeStamp;
         }
 
         if(inp_levels[keyIndex] < 127)
