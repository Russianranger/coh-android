@@ -977,6 +977,23 @@ void checkOddball()
 
 #include "UI/uiUtil.h"
 #include "UI/sprite/sprite_text.h"
+// ArmPort: a key pressed before this client asked to quit is not a request to
+// stay. The Enter that sends /quittologin reaches the chat window as WM_KEYDOWN
+// in one frame, and its DirectInput edge (queued by Wine's keyboard hook during
+// that frame's message pump) in the next. At a few frames per second the
+// server's logout timer is back by then, and the stock check below cancelled the
+// logout it had just asked for (CI: client left in the zone, no save).
+static int armportKeyPressedBeforeQuit(int key)
+{
+    extern U32 g_armport_quit_request_ms;
+    S32 before = (S32)(g_armport_quit_request_ms - inpEdgeTime(key));
+
+    if (!g_armport_quit_request_ms || before < 0)
+        return 0;
+    printf("ARMPORT_LOGOUT_KEY_V1 key=%d pressed_ms_before_quit=%d logout_kept=1\n", key, before);
+    return 1;
+}
+
 void checkLogoutProgress()
 {
     Entity *p = playerPtr();
@@ -1043,7 +1060,7 @@ void checkLogoutProgress()
         {
             for(i=0;i<INP_KEY_LAST;i++)
             {
-                if (inpEdge(i))
+                if (inpEdge(i) && !armportKeyPressedBeforeQuit(i))
                 {
                     printf("aborted by key: %d\n",i);
                     commSendQuitGame(1);
