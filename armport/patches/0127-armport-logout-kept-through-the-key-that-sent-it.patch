+// ArmPort: when this client last asked to quit (timeGetTime milliseconds,
+// 0 = never). checkLogoutProgress keeps a logout through keys pressed before it.
+U32 g_armport_quit_request_ms;
+
+void armportNoteQuitRequest(int abort_quit)
+{
+    if (!abort_quit)
+        g_armport_quit_request_ms = timeGetTime();
+}
