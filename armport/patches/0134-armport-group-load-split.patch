+// ArmPort evidence (patch 0134): where a group file's load time goes. Three leaf costs are
+// timed where they happen, so they never contain one another: reading a file (its prepared
+// .bin, or parsing its .txt), writing its .bin (patch 0133), and loading its geometry file.
+// What is left of a zone load's full_ms is building the definitions. Ticks of
+// QueryPerformanceCounter; patch 0131's line prints the differences over one zone load.
+long long armport_group_read_ticks, armport_group_write_ticks, armport_group_geo_ticks;
+int armport_group_geo_loads;
+
+static long long armportGroupSplitNow(void)
+{
+    LARGE_INTEGER value;
+    return QueryPerformanceCounter(&value) ? value.QuadPart : 0;
+}
+
+#if CLIENT
+static void armportGroupGeoLoad(const char *name)
+{
+    long long began = armportGroupSplitNow();
+
+    geoLoad(name, LOAD_NOW, GEO_INIT_FOR_DRAWING | GEO_USED_BY_WORLD);
+    armport_group_geo_ticks += armportGroupSplitNow() - began;
+    armport_group_geo_loads++;
+}
+#endif
+
