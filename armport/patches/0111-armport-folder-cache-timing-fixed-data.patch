+static int armportFixedData(void)
+{
+    static int fixed = -1;
+    if (fixed < 0) {
+        const char *value = getenv("ARMPORT_FIXED_DATA");
+        fixed = value && strcmp(value, "1") == 0;
+    }
+    return fixed;
+}
+
 void FolderCacheAddFolder(FolderCache *fc, const char *basepath, int virtual_location) {
