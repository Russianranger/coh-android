diff --git a/Game/src/graphics/armport_world_trace.h b/Game/src/graphics/armport_world_trace.h
new file mode 100644
index 0000000..3420d89
--- /dev/null
+++ b/Game/src/graphics/armport_world_trace.h
@@ -0,0 +1,15 @@
+#ifndef ARMPORT_WORLD_TRACE_H
+#define ARMPORT_WORLD_TRACE_H
+/* Diagnostic counters only; original traversal/culling decisions are unchanged. */
+#if (defined(__aarch64__) && defined(__MINGW32__)) || defined(COH_ARMPORT_REFERENCE_I686)
+typedef struct ArmPortWorldTrace
+{
+    unsigned active, visits, editor_skip, distance_skip, frustum_skip;
+    unsigned model_calls, model_not_loaded, alpha_zero, sort_requests;
+} ArmPortWorldTrace;
+extern ArmPortWorldTrace armport_world_trace;
+#define ARMPORT_WORLD_COUNT(field) do { if (armport_world_trace.active) ++armport_world_trace.field; } while (0)
+#else
+#define ARMPORT_WORLD_COUNT(field) ((void)0)
+#endif
+#endif
