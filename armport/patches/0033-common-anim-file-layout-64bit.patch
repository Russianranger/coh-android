+        U8 * raw;
+        *ret = SHAR_Error;
+        if ( load_type == LOAD_ALL || load_type == LOAD_ALL_SHARED )
+            file_size = fileGetSize( file );
+        else
+        {
+            fread( &file_size, sizeof( int ), 1, file );
+            fseek( file, 0, SEEK_SET );
+        }
+        raw = malloc( file_size );
+        assert( raw );
+        if ( fread( raw, 1, file_size, file ) != (size_t)file_size )
+            FatalErrorFilenamef(fileName, "Could not read animation file");
+        skeleton = animConvertFileImage( raw, file_size, load_type != LOAD_SKELETONS_ONLY, fileName );
+        free( raw );
+        if ( load_type != LOAD_SKELETONS_ONLY )
+            for( i = 0 ; i < skeleton->bone_track_count ; i++ )
+                animDebugCheckBoneTrackOnLoad( &skeleton->bone_tracks[i], fileName );
+        (void)bt; (void)track_data; (void)pHandle;
+        return skeleton;
+    }
+#endif
+
     if ( load_type == LOAD_ALL_SHARED )
     {
         *ret = sharedHeapAcquire(&pHandle, fileName);
@@ -209,7 +339,15 @@ SkeletonAnimTrack * animLoadAnimFile( const char* fileName )
     }
     fread( pTrack, 1, file_size, f );
 
+#if defined(_WIN64)
+    {
+        SkeletonAnimTrack * native = animConvertFileImage( (const U8 *)pTrack, file_size, 1, fileName );
+        free( pTrack );
+        pTrack = native;
+    }
+#else
     animPatchLoadedRawData( pTrack );
+#endif
     animValidateTrackData( pTrack );
 
     fclose(f);
