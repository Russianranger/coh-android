+// x86 volatile publication relied on its strong memory ordering. ARM64 needs
+// atomic publication of filled command slots, consumed slots and the wake
+// handshake. Sequential consistency also forbids the producer and consumer
+// both missing each other's publication before the consumer sleeps.
+#if defined(__aarch64__) && defined(__MINGW32__)
+#define wtSharedLoad(value) __atomic_load_n(&(value), __ATOMIC_SEQ_CST)
+#define wtSharedStore(value, next) __atomic_store_n(&(value), (next), __ATOMIC_SEQ_CST)
+#else
+#define wtSharedLoad(value) (value)
+#define wtSharedStore(value, next) ((value) = (next))
+#endif
+
