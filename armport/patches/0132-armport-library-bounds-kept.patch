diff --git a/Game/src/group/armport_library_bounds.h b/Game/src/group/armport_library_bounds.h
new file mode 100644
index 0000000..beb5b29
--- /dev/null
+++ b/Game/src/group/armport_library_bounds.h
@@ -0,0 +1,418 @@
+/* ArmPort opt-in (ARMPORT_LIBRARY_BOUNDS_CACHE=<file>): the client remembers the bounds of
+ * object library files it has loaded, and does not load them again at a zone load (patch 0132).
+ *
+ * 0.13.80, CI run 45121536099 (patch 0131's line, four loads of Atlas Park):
+ *   total_ms=6705..7939 files=508 known=166 bounds=0 full=341 full_ms=6352..7539 map_ms=270..334
+ * Of the 508 group files a zone names, 341 object library files were loaded in full, every
+ * time, and that was 95 % of the 6.7-7.9 s. The engine has a shortcut: a library file whose
+ * geobin .bounds file matches the server's checksum is not loaded; its public definitions only
+ * get their bounds (objectLibrarySetBounds) and each is loaded when first needed. Here the
+ * shortcut never applies: the checksum is the server's, taken over bounds its x86 build
+ * computed, and this client has no bounds files that match it.
+ *
+ * In this single-player build the client and the server read the same object library, so the
+ * comparison protects nothing. With the variable set, after a library file was loaded in full
+ * its public definitions' names and bounds are kept (in memory, and in the named file at the
+ * end of the zone's group files). At a later zone load a file found there is not loaded: its
+ * definitions get the kept bounds through the same objectLibrarySetBounds call the engine's
+ * shortcut makes. The engine's own check still runs first.
+ *
+ * An entry also holds the library file's time stamp as the client sees it and is not used
+ * when that differs; the guest names a new file whenever its identity of the data tree
+ * changes. A file that is missing, cut short, of another version or bounds size, or whose
+ * checksum does not hold is ignored and rewritten. Off by default.
+ *
+ * The including file provides the engine calls; this header only stores and looks up.
+ */
+#ifndef ARMPORT_LIBRARY_BOUNDS_H
+#define ARMPORT_LIBRARY_BOUNDS_H
+#include <utilitieslib/utils/wininclude.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define ARMPORT_LB_MAGIC "ARMLBND1"
+#define ARMPORT_LB_VERSION 1u
+#define ARMPORT_LB_MAX_BYTES (48u * 1024u * 1024u)
+#define ARMPORT_LB_MAX_FILES 32768u
+#define ARMPORT_LB_MAX_DEFS 65535u
+#define ARMPORT_LB_MAX_NAME 259u
+#define ARMPORT_LB_MAX_BOUNDS 256u
+
+typedef struct ArmportLbHeader
+{
+    char magic[8];
+    unsigned version, bounds_bytes, files, payload_bytes, checksum;
+} ArmportLbHeader;
+
+/* One library file in `data`:
+ *   u32 stamp, u32 defs, u16 name bytes, name (lower case, '/'), then per definition
+ *   u16 name bytes, name, bounds_bytes of bounds. */
+typedef struct ArmportLbEntry
+{
+    unsigned offset, bytes, hash;
+} ArmportLbEntry;
+
+typedef struct ArmportLb
+{
+    int state;                      /* 0 unread, 1 on, -1 off */
+    char path[MAX_PATH];
+    unsigned bounds_bytes;
+    unsigned char *data;            /* every record ever added; a replaced one stays, unindexed */
+    unsigned used, size;
+    ArmportLbEntry *entries;
+    unsigned count, capacity;
+    unsigned open;                  /* offset of the record being written, or ~0u */
+    int dirty, failed;
+    unsigned kept;                  /* records added since the last flush */
+} ArmportLb;
+
+static ArmportLb armport_lb;
+
+static unsigned armportLbChecksum(const unsigned char *data, unsigned length)
+{
+    unsigned hash = 2166136261u, i;
+    for (i = 0; i < length; i++)
+    {
+        hash ^= data[i];
+        hash *= 16777619u;
+    }
+    return hash;
+}
+
+static unsigned armportLbU32(const unsigned char *p)
+{
+    return (unsigned)p[0] | ((unsigned)p[1] << 8) | ((unsigned)p[2] << 16) | ((unsigned)p[3] << 24);
+}
+
+static unsigned armportLbU16(const unsigned char *p)
+{
+    return (unsigned)p[0] | ((unsigned)p[1] << 8);
+}
+
+/* Lower case with '/', as the key of a library file. 0 when the name does not fit. */
+static unsigned armportLbKey(const char *name, char *key)
+{
+    unsigned length = 0;
+    if (!name)
+        return 0;
+    for (; name[length]; length++)
+    {
+        char c = name[length];
+        if (length >= ARMPORT_LB_MAX_NAME)
+            return 0;
+        if (c >= 'A' && c <= 'Z')
+            c = (char)(c - 'A' + 'a');
+        key[length] = c == '\\' ? '/' : c;
+    }
+    key[length] = 0;
+    return length;
+}
+
+static int armportLbReserve(unsigned more)
+{
+    unsigned char *grown;
+    unsigned size;
+    if (armport_lb.failed || more > ARMPORT_LB_MAX_BYTES || armport_lb.used > ARMPORT_LB_MAX_BYTES - more)
+    {
+        armport_lb.failed = 1;
+        return 0;
+    }
+    if (armport_lb.used + more <= armport_lb.size)
+        return 1;
+    size = armport_lb.size ? armport_lb.size : 65536u;
+    while (size < armport_lb.used + more)
+        size *= 2;
+    grown = (unsigned char *)realloc(armport_lb.data, size);
+    if (!grown)
+    {
+        armport_lb.failed = 1;
+        return 0;
+    }
+    armport_lb.data = grown;
+    armport_lb.size = size;
+    return 1;
+}
+
+static void armportLbPut(const void *bytes, unsigned length)
+{
+    if (!armportLbReserve(length))
+        return;
+    memcpy(armport_lb.data + armport_lb.used, bytes, length);
+    armport_lb.used += length;
+}
+
+static void armportLbPut32(unsigned value)
+{
+    unsigned char bytes[4];
+    bytes[0] = (unsigned char)value; bytes[1] = (unsigned char)(value >> 8);
+    bytes[2] = (unsigned char)(value >> 16); bytes[3] = (unsigned char)(value >> 24);
+    armportLbPut(bytes, 4);
+}
+
+static void armportLbPut16(unsigned value)
+{
+    unsigned char bytes[2];
+    bytes[0] = (unsigned char)value; bytes[1] = (unsigned char)(value >> 8);
+    armportLbPut(bytes, 2);
+}
+
+/* The byte length of the record at `offset` if it is whole and well formed, else 0. */
+static unsigned armportLbRecordBytes(const unsigned char *data, unsigned used, unsigned offset, unsigned bounds_bytes)
+{
+    unsigned at = offset, defs, length, i;
+    if (used < offset || used - offset < 10)
+        return 0;
+    defs = armportLbU32(data + at + 4);
+    length = armportLbU16(data + at + 8);
+    at += 10;
+    if (defs > ARMPORT_LB_MAX_DEFS || !length || length > ARMPORT_LB_MAX_NAME || used - at < length)
+        return 0;
+    at += length;
+    for (i = 0; i < defs; i++)
+    {
+        if (used - at < 2)
+            return 0;
+        length = armportLbU16(data + at);
+        at += 2;
+        if (!length || length > ARMPORT_LB_MAX_NAME || used - at < length || used - at - length < bounds_bytes)
+            return 0;
+        at += length + bounds_bytes;
+    }
+    return at - offset;
+}
+
+static int armportLbFind(const char *key, unsigned length)
+{
+    unsigned hash = armportLbChecksum((const unsigned char *)key, length), i;
+    for (i = 0; i < armport_lb.count; i++)
+    {
+        const unsigned char *record = armport_lb.data + armport_lb.entries[i].offset;
+        if (armport_lb.entries[i].hash == hash && armportLbU16(record + 8) == length
+            && !memcmp(record + 10, key, length))
+            return (int)i;
+    }
+    return -1;
+}
+
+/* Index the record at `offset` under its own name, in place of an older one of that name. */
+static int armportLbIndex(unsigned offset, unsigned bytes)
+{
+    const unsigned char *record = armport_lb.data + offset;
+    unsigned length = armportLbU16(record + 8);
+    int found = armportLbFind((const char *)record + 10, length);
+    if (found < 0)
+    {
+        if (armport_lb.count >= ARMPORT_LB_MAX_FILES)
+            return 0;
+        if (armport_lb.count == armport_lb.capacity)
+        {
+            unsigned capacity = armport_lb.capacity ? armport_lb.capacity * 2 : 1024u;
+            ArmportLbEntry *grown = (ArmportLbEntry *)realloc(armport_lb.entries, capacity * sizeof(*grown));
+            if (!grown)
+                return 0;
+            armport_lb.entries = grown;
+            armport_lb.capacity = capacity;
+        }
+        found = (int)armport_lb.count++;
+    }
+    armport_lb.entries[found].offset = offset;
+    armport_lb.entries[found].bytes = bytes;
+    armport_lb.entries[found].hash = armportLbChecksum(record + 10, length);
+    return 1;
+}
+
+static void armportLbRead(void)
+{
+    ArmportLbHeader header;
+    DWORD got = 0, size;
+    unsigned offset = 0, files = 0;
+    HANDLE file = CreateFileA(armport_lb.path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING,
+                              FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return;
+    size = GetFileSize(file, NULL);
+    if (size != INVALID_FILE_SIZE && size >= sizeof(header) && size - sizeof(header) <= ARMPORT_LB_MAX_BYTES
+        && ReadFile(file, &header, sizeof(header), &got, NULL) && got == sizeof(header)
+        && !memcmp(header.magic, ARMPORT_LB_MAGIC, 8) && header.version == ARMPORT_LB_VERSION
+        && header.bounds_bytes == armport_lb.bounds_bytes && header.files <= ARMPORT_LB_MAX_FILES
+        && header.payload_bytes == size - sizeof(header) && armportLbReserve(header.payload_bytes)
+        && (!header.payload_bytes
+            || (ReadFile(file, armport_lb.data, header.payload_bytes, &got, NULL) && got == header.payload_bytes))
+        && armportLbChecksum(armport_lb.data, header.payload_bytes) == header.checksum)
+    {
+        armport_lb.used = header.payload_bytes;
+        while (offset < armport_lb.used)
+        {
+            unsigned bytes = armportLbRecordBytes(armport_lb.data, armport_lb.used, offset, armport_lb.bounds_bytes);
+            if (!bytes || !armportLbIndex(offset, bytes))
+                break;
+            offset += bytes;
+            files++;
+        }
+        if (offset != armport_lb.used || files != header.files || armport_lb.count != files)
+        {
+            armport_lb.used = 0;            /* not what a flush writes: start empty */
+            armport_lb.count = 0;
+        }
+    }
+    CloseHandle(file);
+}
+
+/* 1 when the variable names a file and `bounds_bytes` can be stored; reads the file once. */
+static int armportLibraryBoundsEnabled(unsigned bounds_bytes)
+{
+    if (!armport_lb.state)
+    {
+        const char *path = getenv("ARMPORT_LIBRARY_BOUNDS_CACHE");
+        armport_lb.state = -1;
+        armport_lb.open = ~0u;
+        if (path && path[0] && strlen(path) < MAX_PATH - 8 && bounds_bytes && bounds_bytes <= ARMPORT_LB_MAX_BOUNDS)
+        {
+            strcpy(armport_lb.path, path);
+            armport_lb.bounds_bytes = bounds_bytes;
+            armport_lb.state = 1;
+            armportLbRead();
+        }
+    }
+    return armport_lb.state > 0 && armport_lb.bounds_bytes == bounds_bytes;
+}
+
+/* Hands every kept definition of `fname` to `set`; 1 when the file was kept with this stamp. */
+static int armportLibraryBoundsApply(const char *fname, unsigned stamp,
+                                     void (*set)(const char *name, const void *bounds))
+{
+    char key[ARMPORT_LB_MAX_NAME + 1], name[ARMPORT_LB_MAX_NAME + 1];
+    union { double align; unsigned char bytes[ARMPORT_LB_MAX_BOUNDS]; } bounds;
+    const unsigned char *record;
+    unsigned length = armportLbKey(fname, key), defs, i;
+    int found;
+
+    if (armport_lb.state <= 0 || !length || (found = armportLbFind(key, length)) < 0)
+        return 0;
+    record = armport_lb.data + armport_lb.entries[found].offset;
+    if (armportLbU32(record) != stamp)
+        return 0;
+    defs = armportLbU32(record + 4);
+    record += 10 + length;
+    for (i = 0; i < defs; i++)
+    {
+        length = armportLbU16(record);
+        memcpy(name, record + 2, length);
+        name[length] = 0;
+        memcpy(bounds.bytes, record + 2 + length, armport_lb.bounds_bytes);
+        set(name, bounds.bytes);
+        record += 2 + length + armport_lb.bounds_bytes;
+    }
+    return 1;
+}
+
+/* Begin, Add for each public definition, End: keep one library file that was loaded in full. */
+static void armportLibraryBoundsBegin(const char *fname, unsigned stamp)
+{
+    char key[ARMPORT_LB_MAX_NAME + 1];
+    unsigned length = armportLbKey(fname, key);
+    armport_lb.open = ~0u;
+    if (armport_lb.state <= 0 || armport_lb.failed || !length)
+        return;
+    armport_lb.open = armport_lb.used;
+    armportLbPut32(stamp);
+    armportLbPut32(0);
+    armportLbPut16(length);
+    armportLbPut(key, length);
+}
+
+static void armportLibraryBoundsAdd(const char *name, const void *bounds)
+{
+    unsigned length = name ? (unsigned)strlen(name) : 0, defs;
+    unsigned char *record;
+    if (armport_lb.open == ~0u || armport_lb.failed)
+        return;
+    record = armport_lb.data + armport_lb.open;
+    defs = armportLbU32(record + 4);
+    if (!length || length > ARMPORT_LB_MAX_NAME || defs >= ARMPORT_LB_MAX_DEFS)
+    {
+        armport_lb.used = armport_lb.open;      /* a file that cannot be kept whole is not kept */
+        armport_lb.open = ~0u;
+        return;
+    }
+    armportLbPut16(length);
+    armportLbPut(name, length);
+    armportLbPut(bounds, armport_lb.bounds_bytes);
+    if (armport_lb.failed)
+        return;
+    record = armport_lb.data + armport_lb.open;     /* the buffer may have moved */
+    defs++;
+    record[4] = (unsigned char)defs; record[5] = (unsigned char)(defs >> 8);
+    record[6] = (unsigned char)(defs >> 16); record[7] = (unsigned char)(defs >> 24);
+}
+
+static void armportLibraryBoundsEnd(void)
+{
+    unsigned offset = armport_lb.open, bytes;
+    armport_lb.open = ~0u;
+    if (offset == ~0u)
+        return;
+    bytes = armport_lb.failed ? 0 : armportLbRecordBytes(armport_lb.data, armport_lb.used, offset, armport_lb.bounds_bytes);
+    if (!bytes || offset + bytes != armport_lb.used || !armportLbIndex(offset, bytes))
+    {
+        armport_lb.used = offset;
+        return;
+    }
+    armport_lb.dirty = 1;
+    armport_lb.kept++;
+}
+
+/* Writes every indexed record to the named file (a temporary file, then a rename). Returns
+ * the number of records kept since the last flush; a write that fails is tried again later. */
+static unsigned armportLibraryBoundsFlush(void)
+{
+    ArmportLbHeader header;
+    char temporary[MAX_PATH];
+    unsigned char *payload;
+    unsigned total = 0, at = 0, i, kept = armport_lb.kept;
+    DWORD written = 0;
+    HANDLE file;
+    int ok;
+
+    if (armport_lb.state <= 0 || !armport_lb.dirty || armport_lb.open != ~0u)
+        return 0;
+    for (i = 0; i < armport_lb.count; i++)
+        total += armport_lb.entries[i].bytes;
+    payload = (unsigned char *)malloc(total ? total : 1);
+    if (!payload)
+        return 0;
+    for (i = 0; i < armport_lb.count; i++)
+    {
+        memcpy(payload + at, armport_lb.data + armport_lb.entries[i].offset, armport_lb.entries[i].bytes);
+        at += armport_lb.entries[i].bytes;
+    }
+    memset(&header, 0, sizeof(header));
+    memcpy(header.magic, ARMPORT_LB_MAGIC, 8);
+    header.version = ARMPORT_LB_VERSION;
+    header.bounds_bytes = armport_lb.bounds_bytes;
+    header.files = armport_lb.count;
+    header.payload_bytes = total;
+    header.checksum = armportLbChecksum(payload, total);
+    strcpy(temporary, armport_lb.path);
+    strcat(temporary, ".tmp");
+    file = CreateFileA(temporary, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    ok = file != INVALID_HANDLE_VALUE;
+    if (ok)
+    {
+        ok = WriteFile(file, &header, sizeof(header), &written, NULL) && written == sizeof(header)
+            && (!total || (WriteFile(file, payload, total, &written, NULL) && written == total));
+        CloseHandle(file);
+        if (!ok || !MoveFileExA(temporary, armport_lb.path, MOVEFILE_REPLACE_EXISTING))
+        {
+            DeleteFileA(temporary);
+            ok = 0;
+        }
+    }
+    free(payload);
+    if (!ok)
+        return 0;
+    armport_lb.dirty = 0;
+    armport_lb.kept = 0;
+    return kept;
+}
+#endif
diff --git a/Game/src/group/groupnetrecv.c b/Game/src/group/groupnetrecv.c
index 3a13352..0d6cab7 100644
--- a/Game/src/group/groupnetrecv.c
+++ b/Game/src/group/groupnetrecv.c
@@ -1,6 +1,7 @@
 #include "edit/edit.h"
 #include <utilitieslib/utils/armport_zone_trace.h>
 #include "group/armport_group_load_log.h"
+#include "group/armport_library_bounds.h"
