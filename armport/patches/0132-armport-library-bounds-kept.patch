 #include "sound/sound.h"
 #include "edit/edit_net.h"
@@ -665,6 +666,41 @@ static bool newWorldIsBase()
     return ( eaSize(&g_base.rooms) > 0 );
 }
 
+// 0132 (opt-in, armport_library_bounds.h): the engine calls of the client's own bounds store.
+static void armportLibraryBoundsSet(const char *name, const void *bounds)
+{
+    objectLibrarySetBounds(name, (GroupBounds*)bounds);
+}
+
+// 1: the file's public definitions have the bounds kept when it was last loaded in full.
+static int armportLibraryBoundsUse(const char *fname)
+{
+    if (!armportLibraryBoundsEnabled(sizeof(GroupBounds)))
+        return 0;
+    return armportLibraryBoundsApply(fname, (unsigned)fileLastChanged(fname), armportLibraryBoundsSet);
+}
+
+// After groupLoadFull: keep what objectLibraryWriteBoundsFile would write for the file.
+static void armportLibraryBoundsKeep(const char *fname)
+{
+    GroupFile *file;
+    int i;
+
+    if (!armportLibraryBoundsEnabled(sizeof(GroupBounds)))
+        return;
+    file = groupFileFind(fname);
+    if (!file || !file->idx)
+        return;
+    armportLibraryBoundsBegin(fname, (unsigned)fileLastChanged(fname));
+    for (i = 0; i < file->count; i++)
+    {
+        GroupDef *def = file->defs[i];
+        if (def && def->name && groupIsPublic(def))
+            armportLibraryBoundsAdd(def->name, (void*)def->min);
+    }
+    armportLibraryBoundsEnd();
+}
+
 static void receiveGroupFile(Packet *pak,int svr_file_idx,GroupFile *loadto)
 {
     int            def_id,get_file,base_file,base_raid;
@@ -737,11 +773,17 @@ static void receiveGroupFile(Packet *pak,int svr_file_idx,GroupFile *loadto)
             armport_group_load.bounds++;
             armport_group_load.bounds_time += armportGroupLoadNow() - armport_began;
         }
+        else if (armportLibraryBoundsUse(fname))
+        {
+            armport_group_load.cached++;
+            armport_group_load.cached_time += armportGroupLoadNow() - armport_began;
+        }
         else
         {
             long long armport_full = armportGroupLoadNow();
             armport_group_load.bounds_time += armport_full - armport_began;
             groupLoadFull(fname);
+            armportLibraryBoundsKeep(fname);
             armport_group_load.full++;
             armport_group_load.full_time += armportGroupLoadNow() - armport_full;
         }
@@ -933,6 +975,7 @@ void worldReceiveGroups(Packet *pak)
             armport_group_load.files = file_count;
         }
 
+    armport_group_load.kept = armportLibraryBoundsFlush();
     armportGroupLoadEnd();
     armportZoneTrace("groups.files.done", NULL);
     PERFINFO_AUTO_STOP_START("middle2", 1);
