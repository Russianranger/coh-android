+
+/**********************************************************************func*
+* smf_FaceToken / smf_FaceFromToken
+*
+* ArmPort: TextAttribs keeps every attribute in an int stack, including the
+* face, which is a TTDrawContext pointer. Faces are long-lived font contexts,
+* so each distinct one gets a small table index (0 stays NULL).
+*/
+#define SMF_MAX_FACES 1024
+static void *s_apvFaces[SMF_MAX_FACES];
+static int s_iFaceCount;
+
+int smf_FaceToken(void *pv)
+{
+    int i;
+    if(!pv)
+        return 0;
+    for(i=0; i<s_iFaceCount; i++)
+    {
+        if(s_apvFaces[i]==pv)
+            return i+1;
+    }
+    if(s_iFaceCount>=SMF_MAX_FACES)
+    {
+        FatalErrorf("ArmPort: more than %d SMF font faces", SMF_MAX_FACES);
+        return 0;
     }
+    s_apvFaces[s_iFaceCount++] = pv;
+    return s_iFaceCount;
+}
+
+void *smf_FaceFromToken(int token)
+{
+    if(token<=0 || token>s_iFaceCount)
+        return NULL;
+    return s_apvFaces[token-1];
 }
 
 /**********************************************************************func*
