         if(_mm_comige_ss(d1, zero)) { // d1 >= zero
@@ -176,7 +184,7 @@ bool frustum_is_sphere_culled_general( GfxFrustum* frustum, Vec3 origin, float r
     {
         // If the sphere origin is on the 'outside' of the plane by more than the
