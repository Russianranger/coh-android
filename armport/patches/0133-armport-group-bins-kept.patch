+// ArmPort opt-in (patch 0133, ARMPORT_GROUP_BINS=<absolute folder>): a production client keeps
+// the prepared form of the group files it parses.
+//
+// 0.13.80/0.13.81 in CI (patch 0131's totals): the client loads 341 object library files in
+// full at every zone load, about 20 ms each, 6.4-7.5 s of a zone load. It is a production
+// client reading loose data (patch 0042), and the imported game data holds no .bin files, so
+// each of them is parsed from its .txt every time: only a development client writes the
+// geobin form after parsing. The server does write them, and its map load fell from 18.5 s
+// to 4.8 s between the session that wrote them and the next (CI run 45125692618).
+//
+// With the variable set, a group file's bin name is under that folder instead of the data
+// view's geobin/ (absolute paths bypass the folder cache: one stat, one open), and a file
+// that had to be parsed is written there as the development client would write it. A
+// production client accepts a bin by its signature and parse-table checksum and does not
+// compare source dates, so the guest names a new folder whenever its identity of the data
+// view changes. Without the variable nothing changes: no bin is written, geobin/ is read.
+int armport_group_bin_reads, armport_group_text_loads, armport_group_bin_writes;
+
+static const char *armportGroupBinRoot(void)
+{
+    static int checked;
+    static char root[MAX_PATH];
+
+    if (!checked)
+    {
+        const char *value = getenv("ARMPORT_GROUP_BINS");
+        size_t length = value ? strlen(value) : 0;
+
+        checked = 1;
+        if (length >= 4 && length < 160 && value[1] == ':')
+        {
+            memcpy(root, value, length + 1);
+            forwardSlashes(root);
+            if (root[length - 1] == '/')
+                root[length - 1] = 0;
+        }
+    }
+    return root[0] ? root : NULL;
+}
+
 static char *makeBinName(const char *fname,char *buf)
 {
     const char    *cs;
@@ -1591,6 +1631,15 @@ static char *makeBinName(const char *fname,char *buf)
         cs = strstriConst(fname,"maps");
     if (!cs)
         return 0;
+    if (armportGroupBinRoot())
+    {
+        // mkdirtree and the file layer hold paths in MAX_PATH buffers: a name that would not
+        // fit has no bin and is parsed, as every file is without the variable.
+        if (strlen(armportGroupBinRoot()) + strlen(cs) + 8 >= MAX_PATH)
+            return 0;
+        sprintf(buf,"%s/%s",armportGroupBinRoot(),cs);
+    }
+    else
     sprintf(buf,"geobin/%s",cs);
     //strcpy(buf,fname);
     s = strrchr(buf,'.');
@@ -1622,10 +1671,14 @@ static void groupWriteGroupAndRootnameToBin( GroupFileLoad * group_file, const c
     if ( fileExists( librootname ) )
         FileListInsert(&g_parselist, librootname, 0);
 
+    if (armportGroupBinRoot())
+        sprintf(fullbinpath,"%s", bin_name);            // already absolute (0133)
+    else
     sprintf(fullbinpath,"%s/%s", fileDataDir(), bin_name);
     forwardSlashes(fullbinpath);
     mkdirtree(fullbinpath);
-    ParserWriteBinaryFile(bin_name, parse_group_list, group_file, &g_parselist, NULL, 0, 0);
+    if (ParserWriteBinaryFile(bin_name, parse_group_list, group_file, &g_parselist, NULL, 0, 0))
+        armport_group_bin_writes++;
     //FileListDestroy(&filelist);
 
     PERFINFO_AUTO_STOP_CHECKED("groupWriteGroupAnRootNameToBin");
@@ -1672,6 +1725,8 @@ static GroupFile *groupLoadInternal(const char *fname, BinForceType reprocessBin
                 binfile = ParserIsPersistNewer(NULL, NULL, bin_name, parse_group_list, NULL);
             if ( binfile ) 
                 loadedFromBin = ParserReadBinaryFile(binfile, bin_name, parse_group_list, &group_file, NULL, NULL) ;
+            if (loadedFromBin)
+                armport_group_bin_reads++;
 #ifndef FINAL
             else if(!isDevelopmentMode()) {
                 printf("Failed to load group file: %s\n", bin_name);
@@ -1688,7 +1743,8 @@ static GroupFile *groupLoadInternal(const char *fname, BinForceType reprocessBin
         FileListDestroy(&g_parselist); //cleans out g_parselist. I don't know why it's not cleaned out already...
         groupLoadRaw( librootname, &group_file ); //only if it exists. (Duplicates in .txt and ,rootnames are concatenated 
         groupLoadRaw( fname, &group_file );
-        if ( reprocessBins != BIN_REBUILD_MAP && isDevelopmentMode())
+        armport_group_text_loads++;
+        if ( reprocessBins != BIN_REBUILD_MAP && (isDevelopmentMode() || armportGroupBinRoot()))
             groupWriteGroupAndRootnameToBin( &group_file, fname, librootname );
         if (file_dep_info) { // Add include files to depency file
             FileListForEach(&g_parselist, addDependencyCallback);
