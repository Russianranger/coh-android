@@ -185,7 +185,14 @@ static TokenizerParseInfo ParseDetailCategory[] =
     { "ControlPriority", TOK_INT(DetailCategory, iControlPriority,0) },
 
     // Used for shared memory only
+#if defined(_WIN64)
+    // ArmPort: a pointer array described as an int array (for shared-memory
