+/**********************************************************************func*
+* smf_AnchorToken / smf_AnchorFromToken
+*
+* ArmPort: the anchor stack held SMAnchor pointers cast to int; on 64-bit a
+* heap anchor above 2 GB came back sign-extended (Thor fault reading
+* FFFFFFFFA3E25370 in smf_RenderTextAndWhitespace). Each attribute set keeps
+* the pointers in its own pointer earray and the int stack holds 1-based
+* indices into it. Entries are only appended while the set is in use and are
+* cleared with the stacks (smf_InitTextAttribs) or destroyed with the set, so
+* an index stays bound to its anchor for as long as any stack can hold it.
+*/
+int smf_AnchorToken(TextAttribs *pattr, void *pv)
+{
+    if(!pv || !pattr)
+        return 0;
+    eaPush(&pattr->ppvAnchors, pv);
+    return eaSize(&pattr->ppvAnchors);
+}
+
+void *smf_AnchorFromToken(TextAttribs *pattr, int token)
+{
+    if(!pattr || token<=0 || token>eaSize(&pattr->ppvAnchors))
+        return NULL;
+    return pattr->ppvAnchors[token-1];
+}
+
 /**********************************************************************func*
 * smf_PopAttrib
 *
