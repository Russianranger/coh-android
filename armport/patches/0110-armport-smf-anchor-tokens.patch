+/**********************************************************************func*
+* smf_AnchorToken / smf_AnchorFromToken
+*
+* ArmPort: the anchor stack held SMAnchor pointers cast to int; on 64-bit a
+* heap anchor above 2 GB came back sign-extended (Thor fault reading
+* FFFFFFFFA3E25370 in smf_RenderTextAndWhitespace). Anchors belong to their
+* blocks and are freed with them, so they get ring slots instead of a
+* permanent table. Every SMF pass resets the stacks (smf_InitTextAttribs) and
+* resolves its tokens within the pass, far fewer than SMF_ANCHOR_SLOTS later.
+*/
+#define SMF_ANCHOR_SLOTS 65536
+static void *s_apvAnchors[SMF_ANCHOR_SLOTS];
+static unsigned int s_uNextAnchor;
+
+int smf_AnchorToken(void *pv)
+{
+    unsigned int slot;
+    if(!pv)
+        return 0;
+    slot = s_uNextAnchor++ % SMF_ANCHOR_SLOTS;
+    s_apvAnchors[slot] = pv;
+    return (int)slot + 1;
+}
+
+void *smf_AnchorFromToken(int token)
+{
+    if(token<=0 || token>SMF_ANCHOR_SLOTS)
+        return NULL;
+    return s_apvAnchors[token-1];
+}
+
 /**********************************************************************func*
 * smf_PopAttrib
 *
