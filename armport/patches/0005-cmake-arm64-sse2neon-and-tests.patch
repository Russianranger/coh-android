diff --git a/cmake/dependencies/Sse2Neon.cmake b/cmake/dependencies/Sse2Neon.cmake
new file mode 100644
index 0000000..809d189
--- /dev/null
+++ b/cmake/dependencies/Sse2Neon.cmake
@@ -0,0 +1,10 @@
+include_guard(GLOBAL)
+include(CPM)
+
+# ArmPort: header-only SSE-to-NEON translation for the ARM64 Windows build.
+CPMAddPackage(
+	NAME sse2neon
+	GIT_REPOSITORY "https://github.com/DLTcollab/sse2neon"
+	GIT_TAG 3cf69760cc6fdc45a5d70f0d42a8f079489f9867 # v1.8.0
+	DOWNLOAD_ONLY YES
+)
