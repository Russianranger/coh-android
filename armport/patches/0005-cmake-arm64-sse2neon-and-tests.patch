diff --git a/CMakeLists.txt b/CMakeLists.txt
index 93d399a..f0956d0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -50,6 +50,13 @@ if(COX_ARM64_WINDOWS)
 		"$<$<COMPILE_LANGUAGE:C>:-Wno-error=implicit-int;-Wno-error=implicit-function-declaration;-fcommon>")
 endif()
 
+if(COX_ARM64_WINDOWS)
+	# x86 SSE headers resolve to shims that use sse2neon on ARM64.
+	include(dependencies/Sse2Neon)
+	include_directories(BEFORE SYSTEM
+		"${CMAKE_CURRENT_SOURCE_DIR}/cmake/armport-include" "${sse2neon_SOURCE_DIR}")
+endif()
+
 # Run this mandatory check before other targets, even with testing disabled.
 add_executable(cox_precise_floating_point_test EXCLUDE_FROM_ALL
 	cmake/tests/precise_floating_point.cpp)
@@ -164,4 +171,10 @@ function(cox_require_precise_floating_point directory)
 	endforeach()
 endfunction()
 
+# ArmPort: optional test programs kept outside this source tree.
+set(COX_ARMPORT_TESTS_DIR "" CACHE PATH "armport/tests directory to build (ARM64 only)")
+if(COX_ARM64_WINDOWS AND COX_ARMPORT_TESTS_DIR)
+	add_subdirectory("${COX_ARMPORT_TESTS_DIR}" armport-tests)
+endif()
+
 cox_require_precise_floating_point("${CMAKE_CURRENT_SOURCE_DIR}")
diff --git a/cmake/armport-include/emmintrin.h b/cmake/armport-include/emmintrin.h
new file mode 100644
index 0000000..f25e64c
--- /dev/null
+++ b/cmake/armport-include/emmintrin.h
@@ -0,0 +1,6 @@
+/* ArmPort: x86 SSE header. On ARM64, translate SSE intrinsics to NEON with sse2neon. */
+#if defined(__aarch64__)
+#include <sse2neon.h>
+#else
+#include_next <emmintrin.h>
+#endif
