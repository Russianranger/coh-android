diff --git a/CMakeLists.txt b/CMakeLists.txt
index 17dc6e0..cceaaaa 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -36,7 +36,7 @@ if(MSVC)
 		$<$<OR:$<COMPILE_LANGUAGE:C>,$<COMPILE_LANGUAGE:CXX>>:/fp:precise>)
 endif()
 
-if(COX_ARM64_WINDOWS)
+if(COX_ARMPORT_WINDOWS)
 	# The engine relies on Microsoft C extensions and on aliasing through typed
 	# pointers. -fno-autolink drops #pragma comment(lib) directives: CMake links
 	# the same libraries by their lowercase names, and the Linux host's
@@ -50,7 +50,7 @@ if(COX_ARM64_WINDOWS)
 		"$<$<COMPILE_LANGUAGE:C>:-Wno-error=implicit-int;-Wno-error=implicit-function-declaration;-fcommon>")
 endif()
 
-if(COX_ARM64_WINDOWS)
+if(COX_ARMPORT_WINDOWS)
 	# SHARED_MEMORY data is written at load time. MSVC places it in a read/write
 	# named section (#pragma section); with clang that section conflicts with
 	# its const objects, and the section is not shared anyway. Use the existing
@@ -58,7 +58,7 @@ if(COX_ARM64_WINDOWS)
 	add_compile_definitions(DISABLE_SHARED_MEMORY_SEGMENT)
 endif()
 
-if(COX_ARM64_WINDOWS)
+if(COX_ARMPORT_WINDOWS)
 	# x86 SSE headers resolve to shims that use sse2neon on ARM64.
 	include(dependencies/Sse2Neon)
 	include_directories(BEFORE SYSTEM
@@ -93,7 +93,7 @@ endif()
 add_subdirectory(Utilities/StructParser)
 
 if(WIN32)
-	if(NOT CMAKE_SIZEOF_VOID_P EQUAL 4 AND NOT COX_ARM64_WINDOWS)
+	if(NOT CMAKE_SIZEOF_VOID_P EQUAL 4 AND NOT COX_ARMPORT_WINDOWS)
 		message(FATAL_ERROR "CoX supports only 32-bit Windows builds")
 	endif()
 	enable_language(RC)
@@ -185,7 +185,7 @@ endfunction()
 
 # ArmPort: optional test programs kept outside this source tree.
 set(COX_ARMPORT_TESTS_DIR "" CACHE PATH "armport/tests directory to build (ARM64 only)")
-if(COX_ARM64_WINDOWS AND COX_ARMPORT_TESTS_DIR)
+if(COX_ARMPORT_WINDOWS AND COX_ARMPORT_TESTS_DIR)
 	add_subdirectory("${COX_ARMPORT_TESTS_DIR}" armport-tests)
 endif()
 
