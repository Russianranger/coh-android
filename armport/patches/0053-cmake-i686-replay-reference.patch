diff --git a/cmake/CoXTargets.cmake b/cmake/CoXTargets.cmake
index 323e619..9dabf1f 100644
--- a/cmake/CoXTargets.cmake
+++ b/cmake/CoXTargets.cmake
@@ -13,6 +13,21 @@ if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND
 	set(COX_ARM64_WINDOWS ON)
 endif()
 
+# Same original receiver, 32-bit comparison build only; never the shipped client.
+option(COX_ARMPORT_REFERENCE_I686 "Build the ArmPort i686 replay reference" OFF)
+if(COX_ARMPORT_REFERENCE_I686)
+    if(NOT MINGW OR NOT CMAKE_SIZEOF_VOID_P EQUAL 4 OR
+       NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(i686|x86)$")
+        message(FATAL_ERROR "ArmPort reference requires 32-bit i686 llvm-mingw")
+    endif()
+    add_compile_definitions(COH_ARMPORT_REFERENCE_I686=1)
+    add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:-msse2;-mfpmath=sse;-fasm-blocks>")
+endif()
+set(COX_ARMPORT_WINDOWS OFF)
+if(COX_ARM64_WINDOWS OR COX_ARMPORT_REFERENCE_I686)
+    set(COX_ARMPORT_WINDOWS ON)
+endif()
+
 option(COX_BUILD_DEV_TOOLS "Build diagnostic utilities" OFF)
 option(COX_BUILD_ART_TOOLS "Build art conversion tools" OFF)
 
@@ -36,7 +51,7 @@ function(cox_add_project target directory)
 	set(option_name "COX_BUILD_${option_suffix}")
 	option(${option_name} "Build ${target} (MSVC Win32 only)" ${default})
 	if(${option_name})
-		if(NOT COX_MSVC_WIN32 AND NOT COX_ARM64_WINDOWS)
+		if(NOT COX_MSVC_WIN32 AND NOT COX_ARMPORT_WINDOWS)
 			message(FATAL_ERROR
 				"${target} requires MSVC and 32-bit Windows (Win32)")
 		endif()
