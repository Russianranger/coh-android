+// ArmPort: saved folder-cache index (patch 0122). The ARM64 client's upfront
+// scan lists every loose data file (160,114 on the Thor, 106-114 s under
+// Wine/FEX/PRoot). When ARMPORT_FOLDER_CACHE_INDEX names a file and
+// ARMPORT_FOLDER_CACHE_ID gives the Android guest's identity of the data tree
+// (it changes whenever a source directory or link target changes, the ARM64
+// overlay or the skip list), the scan result is saved there and the next
+// start with the same identity rebuilds the same nodes from it. Root folders
+// that change without their directory changing are always scanned live: bin/
+// (the overlay, unpacked fresh every launch) and those named in
+// ARMPORT_FOLDER_CACHE_LIVE (comma-separated, at most 8; the guest names the
+// writable cache roots geobin and server).
+// The header must match exactly, the payload checksum and bounds must hold,
+// and up to 64 sampled files must still have their recorded size and
+// timestamp; otherwise the full scan runs and rewrites the index.
+#define ARMPORT_FCI_MAGIC "ARMFCIX1"
+#define ARMPORT_FCI_VERSION 1
+#define ARMPORT_FCI_MAX_BYTES (64u * 1024u * 1024u)
+#define ARMPORT_FCI_SAMPLES 64
+
+typedef struct ArmportFciHeader {
+    char magic[8];
+    U32 version, virtual_location;
+    char id[72], basepath[64], skip[160], live[160];
+    U32 loose, devdata, exclusion;
+    U32 files, folders, skipped, root_count, payload_bytes, checksum;
+} ArmportFciHeader;
+
+typedef struct ArmportFciBuffer {
+    unsigned char *data;
+    U32 used, size, failed;
+} ArmportFciBuffer;
+
+static int armport_fci_used = 0;
+
+static const char *armportFciPath(void)
+{
+    const char *path = getenv("ARMPORT_FOLDER_CACHE_INDEX");
+    const char *id = getenv("ARMPORT_FOLDER_CACHE_ID");
+    if (!path || !path[0] || strlen(path) >= MAX_PATH || !id || !id[0] || strlen(id) >= 72)
+        return NULL;
+    return path;
+}
+
+static U32 armportFciChecksum(const unsigned char *data, U32 length)
+{
+    U32 hash = 2166136261u, i;
+    for (i = 0; i < length; i++) {
+        hash ^= data[i];
+        hash *= 16777619u;
+    }
+    return hash;
+}
+
+static int armportFciLiveRoot(const char *name)
+{
+    static int parsed = 0, count = 0;
+    static char names[8][64];
+    int i;
+    if (!parsed) {
+        const char *value = getenv("ARMPORT_FOLDER_CACHE_LIVE");
+        parsed = 1;
+        while (value && *value && count < 8) {
+            const char *end = strchr(value, ',');
+            size_t len = end ? (size_t)(end - value) : strlen(value);
+            if (len > 0 && len < sizeof(names[0])) {
+                memcpy(names[count], value, len);
+                names[count][len] = 0;
+                count++;
+            }
+            if (!end)
+                break;
+            value = end + 1;
+        }
+    }
+    if (stricmp(name, "bin") == 0)
+        return 1;
+    for (i = 0; i < count; i++)
+        if (stricmp(name, names[i]) == 0)
+            return 1;
+    return 0;
+}
+
+static int armportFciRootBin(FolderNode *parent, const char *name)
+{
+    return parent == NULL && armportFciLiveRoot(name);
+}
+
+// The full scan's root-level folder rules (skip list and exclusion).
+static int armportFciRootAllowed(const char *name)
+{
+    if (armportSkippedRootFolder(name))
+        return 0;
+    switch (folder_cache_exclusion) {
+        xcase FOLDER_CACHE_EXCLUDE_FOLDER:
+            return !(folder_cache_exclusion_folder && stricmp(name, folder_cache_exclusion_folder) == 0);
+        xcase FOLDER_CACHE_ONLY_FOLDER:
+            return !(folder_cache_exclusion_folder && stricmp(name, folder_cache_exclusion_folder) != 0);
+        xdefault:
+            return 1;
+    }
+}
+
+static void armportFciHeaderFill(ArmportFciHeader *header, const char *basepath, int virtual_location)
+{
+    const char *skip = getenv("ARMPORT_FOLDER_CACHE_SKIP");
+    const char *live = getenv("ARMPORT_FOLDER_CACHE_LIVE");
+    memset(header, 0, sizeof(*header));
+    memcpy(header->magic, ARMPORT_FCI_MAGIC, 8);
+    header->version = ARMPORT_FCI_VERSION;
+    header->virtual_location = (U32)virtual_location;
+    strncpy(header->id, getenv("ARMPORT_FOLDER_CACHE_ID"), sizeof(header->id) - 1);
+    strncpy(header->basepath, basepath, sizeof(header->basepath) - 1);
+    strncpy(header->skip, skip ? skip : "", sizeof(header->skip) - 1);
+    strncpy(header->live, live ? live : "", sizeof(header->live) - 1);
+    header->loose = getenv("ARMPORT_LOOSE_DATA") != NULL;
+    header->devdata = fileIsUsingDevData() ? 1 : 0;
+    header->exclusion = (U32)folder_cache_exclusion;
+}
+
+static void armportFciPut(ArmportFciBuffer *buffer, const void *data, U32 length)
+{
+    if (buffer->failed)
+        return;
+    if (buffer->used + length > buffer->size) {
+        U32 size = buffer->size ? buffer->size * 2 : 1024 * 1024;
+        unsigned char *grown;
+        while (size < buffer->used + length)
+            size *= 2;
+        if (size > ARMPORT_FCI_MAX_BYTES || !(grown = realloc(buffer->data, size))) {
+            buffer->failed = 1;
+            return;
+        }
+        buffer->data = grown;
+        buffer->size = size;
+    }
+    memcpy(buffer->data + buffer->used, data, length);
+    buffer->used += length;
+}
+
+// One record per node, depth first in sibling order: flags (1 byte: dir,
+// writeable, hidden, system), name length (2), name, size (4), timestamp (4),
+// then for a folder its child count (4) and children.
+static void armportFciWriteNodes(ArmportFciBuffer *buffer, FolderNode *first, FolderNode *parent)
+{
+    FolderNode *node;
+    for (node = first; node; node = node->next) {
+        unsigned char flags;
+        unsigned short length;
+        U32 size, children = 0;
+        S32 timestamp;
+        FolderNode *child;
+        if (armportFciRootBin(parent, node->name))
+            continue;
+        flags = (unsigned char)((node->is_dir ? 1 : 0) | (node->writeable ? 2 : 0)
+                                | (node->hidden ? 4 : 0) | (node->system ? 8 : 0));
+        length = (unsigned short)strlen(node->name);
+        size = (U32)node->size;
+        timestamp = (S32)node->timestamp;
+        armportFciPut(buffer, &flags, 1);
+        armportFciPut(buffer, &length, 2);
+        armportFciPut(buffer, node->name, length);
+        armportFciPut(buffer, &size, 4);
+        armportFciPut(buffer, &timestamp, 4);
+        if (node->is_dir) {
+            for (child = node->contents; child; child = child->next)
+                children++;
+            armportFciPut(buffer, &children, 4);
+            armportFciWriteNodes(buffer, node->contents, node);
+        }
+    }
+}
+
+static int armportFciWriteFile(const char *path, const void *data, U32 length)
+{
+    char temporary[MAX_PATH + 8];
+    HANDLE file;
+    DWORD written = 0;
+    BOOL ok;
+    sprintf_s(SAFESTR(temporary), "%s.tmp", path);
+    file = CreateFileA(temporary, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return 0;
+    ok = WriteFile(file, data, length, &written, NULL) && written == length && FlushFileBuffers(file);
+    CloseHandle(file);
+    if (!ok || !MoveFileExA(temporary, path, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+        DeleteFileA(temporary);
+        return 0;
+    }
+    return 1;
+}
+
+static void armportFciSave(FolderCache *fc, const char *basepath, int virtual_location)
+{
+    ArmportFciBuffer buffer = {0};
+    ArmportFciHeader header;
+    FolderNode *node;
+    const char *path = armportFciPath();
+    int timer = timerAlloc(), ok = 0;
+    timerStart(timer);
+    armportFciHeaderFill(&header, basepath, virtual_location);
+    armportFciPut(&buffer, &header, sizeof(header));
+    for (node = fc->root; node; node = node->next)
+        if (!armportFciRootBin(NULL, node->name))
+            header.root_count++;
+    armportFciWriteNodes(&buffer, fc->root, NULL);
+    if (!buffer.failed) {
+        header.files = (U32)count_file;
+        header.folders = (U32)count_folder;
+        header.skipped = (U32)armport_skipped_folders;
+        header.payload_bytes = buffer.used - (U32)sizeof(header);
+        header.checksum = armportFciChecksum(buffer.data + sizeof(header), header.payload_bytes);
+        memcpy(buffer.data, &header, sizeof(header));
+        ok = armportFciWriteFile(path, buffer.data, buffer.used);
+    }
+    printf("ARMPORT_FOLDER_CACHE_V1 phase=index result=%s bytes=%u seconds=%.3f\n",
+        ok ? "written" : "write_failed", buffer.used, timerElapsed(timer));
+    free(buffer.data);
+    timerFree(timer);
+}
+
+typedef struct ArmportFciReader {
+    const unsigned char *data;
+    U32 offset, end, files, folders, sample_every, sampled, mismatches;
+    char path[1024];
+} ArmportFciReader;
+
+static int armportFciTake(ArmportFciReader *reader, void *out, U32 length)
+{
+    if (reader->end - reader->offset < length)
+        return 0;
+    memcpy(out, reader->data + reader->offset, length);
+    reader->offset += length;
+    return 1;
+}
+
+static int armportFciSample(ArmportFciReader *reader, U32 size, S32 timestamp)
+{
+    WIN32_FILE_ATTRIBUTE_DATA info;
+    __time32_t utc_time;
+    reader->sampled++;
+    if (!GetFileAttributesExA(reader->path, GetFileExInfoStandard, &info)
+            || (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+        return 0;
+    _FileTimeToUnixTime(&info.ftLastWriteTime, &utc_time, FALSE);
+    return info.nFileSizeLow == size && (S32)utc_time == timestamp;
+}
+
+// pass 0 checks bounds, counts and samples; pass 1 builds the same nodes.
+static int armportFciReadNodes(ArmportFciReader *reader, FolderCache *fc, FolderNode **head, FolderNode **tail,
+                               FolderNode *parent, U32 count, int virtual_location, int build, int depth)
+{
+    U32 i;
+    size_t path_length = strlen(reader->path);
+    if (depth > 64)
+        return 0;
+    for (i = 0; i < count; i++) {
+        unsigned char flags;
+        unsigned short length;
+        U32 size, children = 0;
+        S32 timestamp;
+        char name[MAX_PATH + 2];
+        FolderNode *node;
+        int created;
+        if (!armportFciTake(reader, &flags, 1) || !armportFciTake(reader, &length, 2)
+                || length == 0 || length >= MAX_PATH - 2 || (flags & ~15)
+                || !armportFciTake(reader, name, length) || memchr(name, 0, length))
+            return 0;
+        name[length] = 0;
+        if (strchr(name, '/') || strchr(name, '\\') || name[0] == '.' || (depth == 0 && armportFciLiveRoot(name))
+                || path_length + 1 + length >= sizeof(reader->path)
+                || !armportFciTake(reader, &size, 4) || !armportFciTake(reader, &timestamp, 4))
+            return 0;
+        reader->path[path_length] = '/';
+        memcpy(reader->path + path_length + 1, name, length + 1);
+        if (flags & 1) {
+            if (!armportFciTake(reader, &children, 4))
+                return 0;
+            reader->folders++;
+            if (build) {
+                name[length] = '/';
+                name[length + 1] = 0;
+                node = FolderNodeAdd(head, tail, parent, name, (__time32_t)timestamp, size, virtual_location, -1, &created);
+                if (!node)
+                    return 0;
+                node->is_dir = true;
+                if (created && fc->nodeCreateCallback)
+                    fc->nodeCreateCallback(fc, node);
+                count_folder++;
+                if (!armportFciReadNodes(reader, fc, &node->contents, &node->contents_tail, node, children,
+                                         virtual_location, build, depth + 1))
+                    return 0;
+            } else if (!armportFciReadNodes(reader, fc, NULL, NULL, NULL, children, virtual_location, build, depth + 1)) {
+                return 0;
+            }
+        } else {
+            reader->files++;
+            if (build) {
+                node = FolderNodeAdd(head, tail, parent, name, (__time32_t)timestamp, size, virtual_location, -1, &created);
+                if (node) {
+                    node->writeable = (flags & 2) ? 1 : 0;
+                    node->hidden = (flags & 4) ? 1 : 0;
+                    node->system = (flags & 8) ? 1 : 0;
+                    if (created && fc->nodeCreateCallback)
+                        fc->nodeCreateCallback(fc, node);
+                }
+                count_file++;
+            } else if (reader->sampled < ARMPORT_FCI_SAMPLES && reader->files % reader->sample_every == 0
+                       && !armportFciSample(reader, size, timestamp)) {
+                reader->mismatches++;
+            }
+        }
+        reader->path[path_length] = 0;
+    }
+    return 1;
+}
+
+static void armportFciRead(const char *path, unsigned char **data, U32 *length)
+{
+    HANDLE file = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    DWORD size, got = 0;
+    *data = NULL;
+    *length = 0;
+    if (file == INVALID_HANDLE_VALUE)
+        return;
+    size = GetFileSize(file, NULL);
+    if (size != INVALID_FILE_SIZE && size >= sizeof(ArmportFciHeader) && size <= ARMPORT_FCI_MAX_BYTES
+            && (*data = malloc(size)) != NULL) {
+        if (ReadFile(file, *data, size, &got, NULL) && got == size) {
+            *length = size;
+        } else {
+            free(*data);
+            *data = NULL;
+        }
+    }
+    CloseHandle(file);
+}
+
+// Rebuild the live root folders exactly as the scan does. Their skip count is
+// already in the index header, so a skipped one is not counted again.
+static void armportFciScanLiveRoots(FolderCache *fc, const char *basepath, int virtual_location)
+{
+    char buffer[1024];
+    WIN32_FIND_DATAA wfd;
+    U32 handle;
+    sprintf_s(SAFESTR(buffer), "%s/*", basepath);
+    if (!fwFindFirstFile(&handle, buffer, &wfd))
+        return;
+    do {
+        __time32_t utc_time;
+        FolderNode *node;
+        int created;
+        if (wfd.cFileName[0] == '.' || !(wfd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+                || !armportFciLiveRoot(wfd.cFileName) || !armportFciRootAllowed(wfd.cFileName))
+            continue;
+        _FileTimeToUnixTime(&wfd.ftLastWriteTime, &utc_time, FALSE);
+        STR_COMBINE_SS(buffer, wfd.cFileName, "/");
+        node = FolderNodeAdd(&fc->root, &fc->root_tail, NULL, buffer, utc_time, wfd.nFileSizeLow,
+                             virtual_location, -1, &created);
+        node->is_dir = true;
+        if (created && fc->nodeCreateCallback)
+            fc->nodeCreateCallback(fc, node);
+        count_folder++;
+        STR_COMBINE_SSS(buffer, basepath, "/", node->name);
+        FolderCacheAddFolderToNode(fc, &node->contents, &node->contents_tail, node, buffer, virtual_location);
+    } while (fwFindNextFile(handle, &wfd) != 0);
+    fwFindClose(handle);
+}
+
+// Returns 1 when the nodes came from the index; 0 runs the full scan.
+static int armportFciLoad(FolderCache *fc, const char *basepath, int virtual_location, const char **reason)
+{
+    unsigned char *data;
+    U32 length;
+    ArmportFciHeader expected, header;
+    ArmportFciReader reader;
+    armportFciRead(armportFciPath(), &data, &length);
+    if (!data) {
+        *reason = "absent";
+        return 0;
+    }
+    armportFciHeaderFill(&expected, basepath, virtual_location);
+    memcpy(&header, data, sizeof(header));
+    *reason = "header";
+    if (memcmp(&header, &expected, offsetof(ArmportFciHeader, files)) == 0
+            && header.payload_bytes == length - (U32)sizeof(header)
+            && header.files > 0 && header.files <= 4000000 && header.folders <= 1000000) {
+        *reason = "checksum";
+        if (armportFciChecksum(data + sizeof(header), header.payload_bytes) == header.checksum) {
+            memset(&reader, 0, sizeof(reader));
+            reader.data = data;
+            reader.end = length;
+            reader.offset = sizeof(header);
+            reader.sample_every = header.files / ARMPORT_FCI_SAMPLES ? header.files / ARMPORT_FCI_SAMPLES : 1;
+            strncpy(reader.path, basepath, sizeof(reader.path) - 1);
+            *reason = "records";
+            if (armportFciReadNodes(&reader, fc, NULL, NULL, NULL, header.root_count, virtual_location, 0, 0)
+                    && reader.offset == reader.end && reader.files <= header.files
+                    && reader.folders <= header.folders) {
+                *reason = "stale";
+                if (!reader.mismatches) {
+                    reader.offset = sizeof(header);
+                    reader.path[0] = 0;
+                    strncpy(reader.path, basepath, sizeof(reader.path) - 1);
+                    if (armportFciReadNodes(&reader, fc, &fc->root, &fc->root_tail, NULL, header.root_count,
+                                            virtual_location, 1, 0)) {
+                        armport_skipped_folders = (int)header.skipped;
+                        free(data);
+                        armportFciScanLiveRoots(fc, basepath, virtual_location);
+                        *reason = "match";
+                        return 1;
+                    }
+                    // Unreachable after pass 0 (same bytes). Nodes already added
+                    // are entries of the same tree; the full scan merges into
+                    // them, and its counts start again.
+                    count_file = 0;
+                    count_folder = 0;
+                    *reason = "build";
+                }
+            }
+        }
+    }
+    free(data);
+    return 0;
+}
