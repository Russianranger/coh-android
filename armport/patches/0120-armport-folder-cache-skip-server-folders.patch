+// ArmPort: ARMPORT_FOLDER_CACHE_SKIP is a comma-separated list of top-level
+// data folders that the scan leaves out (case-insensitive, at most 8). The
+// ARM64 client sets it to server-only folders it never reads (scripts.loc,
+// server), about a quarter of the shared loose tree. Unset: unchanged.
+static int armport_skipped_folders = 0;
+static int armportSkippedRootFolder(const char *name)
+{
+    static int parsed = 0, count = 0;
+    static char names[8][64];
+    int i;
+    if (!parsed) {
+        const char *value = getenv("ARMPORT_FOLDER_CACHE_SKIP");
+        parsed = 1;
+        while (value && *value && count < 8) {
+            const char *end = strchr(value, ',');
+            size_t len = end ? (size_t)(end - value) : strlen(value);
+            if (len > 0 && len < sizeof(names[0])) {
+                memcpy(names[count], value, len);
+                names[count][len] = 0;
+                count++;
+            }
+            if (!end)
+                break;
+            value = end + 1;
+        }
+    }
+    for (i = 0; i < count; i++)
+        if (stricmp(name, names[i]) == 0)
+            return 1;
+    return 0;
+}
