diff --git a/CMakeLists.txt b/CMakeLists.txt
index ca45dee..17dc6e0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -63,6 +63,10 @@ if(COX_ARM64_WINDOWS)
 	include(dependencies/Sse2Neon)
 	include_directories(BEFORE SYSTEM
 		"${CMAKE_CURRENT_SOURCE_DIR}/cmake/armport-include" "${sse2neon_SOURCE_DIR}")
