--- a/Game/src/UI/uiBuff.c
+++ b/Game/src/UI/uiBuff.c
@@ -46,6 +46,29 @@ typedef struct PowerBuff
     int window;
 }PowerBuff;
 
+#ifdef COH_ARMPORT_REPLAY
+int armportReplayBuffCount(const Entity *entity)
+{
+    return entity ? eaSize(&entity->ppowBuffs) : 0;
+}
+int armportReplayBuffAt(const Entity *entity, int index, ArmPortReplayBuffView *view)
+{
+    const PowerBuff *buff;
+    if (!entity || !view || index < 0 || index >= eaSize(&entity->ppowBuffs)) return -1;
+    buff = entity->ppowBuffs[index];
+    if (!buff) return 0;
+    view->power = buff->ppow;
+    view->descriptions = (const AttribDescription *const *)buff->ppDesc;
+    view->magnitudes = buff->ppfMag;
+    view->description_count = eaSize(&buff->ppDesc);
+    view->magnitude_count = eafSize(&buff->ppfMag);
+    view->blink = buff->iBlink;
+    view->uid = buff->uid;
+    view->delete_mark = buff->delete_mark;
+    return 1;
+}
+#endif
+
