 void commServerMapXferLoading(Packet *pak_in)
 {
-    g_showMapLoadingMessage = pktGetBits(pak_in, 1);
+    int on = pktGetBits(pak_in, 1);
+
+    /* ArmPort (patch 0125): the DbServer only ever sends "loading" on, and the
+     * load screen (commServerWaitOK) turns it off. With the MapServer's
