@@ -0,0 +1,101 @@
+/* ArmPort: where a zone load's group-file time goes (patch 0131). Evidence only.
+ *
+ * Thor 0.13.79 (export 20261121-202117): the client spent 5.5-6.8 s of every zone load
+ * between "map.start" and "groups.files.done", and the quiet log (patches 0108, 0130) held
+ * nothing in between. This prints one line per new world, after the last group file:
+ *
+ *   ARMPORT_GROUP_LOAD_V1 total_ms= start_ms= files= sent= known= bounds= bounds_ms=
+ *       full= full_ms= map_ms= defs= defs_ms= libs_ms= geo= geo_ms=
+ *
+ *   start_ms   clientLoadMapStart (the load screen and the previous world's teardown)
+ *   files      group files the server listed; sent: those it described in the packet
+ *   known      object library files that were already loaded
+ *   bounds     library files accepted by their geobin .bounds checksum, and the time
+ *   full       library files that had to be loaded in full, and the time
+ *   map_ms     the map file itself with its imported layers (groupLoadTo)
+ *   defs       definitions received from the server, and the time for all of them
+ *   libs_ms    of defs_ms: groupLoadRequiredLibsForDef (geometry files read at once)
+ *   geo        of defs: definitions with a model; geo_ms: looking the models up
+ *
+ * No packet, loading or timeout behavior changes. Only written with ARMPORT_STDIO_LOG set,
+ * like the "ArmPort zone:" lines. Game/UtilitiesLib headers redefine printf/fflush; the
+ * helper isolates those macros like armport_net_clock.h (patch 0123).
+ */
+#ifndef ARMPORT_GROUP_LOAD_LOG_H
+#define ARMPORT_GROUP_LOAD_LOG_H
+#include <utilitieslib/utils/wininclude.h>
+#pragma push_macro("printf")
+#pragma push_macro("snprintf")
+#pragma push_macro("fflush")
+#pragma push_macro("fputs")
+#pragma push_macro("FILE")
+#undef printf
+#undef snprintf
+#undef fflush
+#undef fputs
+#undef FILE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct ArmportGroupLoad
+{
+    int active;                 /* a new world's files are being received */
+    long long began;
+    long long start, bounds_time, full_time, map_time, defs_time, libs_time, geo_time;
+    unsigned files, sent, known, bounds, full, defs, geo;
+} ArmportGroupLoad;
+
+static ArmportGroupLoad armport_group_load;
+
+static long long armportGroupLoadNow(void)
+{
+    LARGE_INTEGER value;
+    if (!QueryPerformanceCounter(&value))
+        return 0;
+    return value.QuadPart;
+}
+
+static unsigned armportGroupLoadMs(long long ticks)
+{
+    LARGE_INTEGER frequency;
+    if (ticks <= 0 || !QueryPerformanceFrequency(&frequency) || frequency.QuadPart <= 0)
+        return 0;
+    return (unsigned)(ticks * 1000 / frequency.QuadPart);
+}
+
+static void armportGroupLoadBegin(void)
+{
+    memset(&armport_group_load, 0, sizeof(armport_group_load));
+    armport_group_load.active = 1;
+    armport_group_load.began = armportGroupLoadNow();
+}
+
+static void armportGroupLoadEnd(void)
+{
+    const ArmportGroupLoad *t = &armport_group_load;
+    char line[400];
+    if (!t->active)
+        return;
+    if (getenv("ARMPORT_STDIO_LOG"))
+    {
+        snprintf(line, sizeof(line),
+            "ARMPORT_GROUP_LOAD_V1 total_ms=%u start_ms=%u files=%u sent=%u known=%u bounds=%u bounds_ms=%u"
+            " full=%u full_ms=%u map_ms=%u defs=%u defs_ms=%u libs_ms=%u geo=%u geo_ms=%u\n",
+            armportGroupLoadMs(armportGroupLoadNow() - t->began), armportGroupLoadMs(t->start),
+            t->files, t->sent, t->known, t->bounds, armportGroupLoadMs(t->bounds_time),
+            t->full, armportGroupLoadMs(t->full_time), armportGroupLoadMs(t->map_time),
+            t->defs, armportGroupLoadMs(t->defs_time), armportGroupLoadMs(t->libs_time),
+            t->geo, armportGroupLoadMs(t->geo_time));
+        fputs(line, stdout);
+        fflush(stdout);
+    }
+    armport_group_load.active = 0;
+}
+
+#pragma pop_macro("FILE")
+#pragma pop_macro("fputs")
+#pragma pop_macro("fflush")
+#pragma pop_macro("snprintf")
+#pragma pop_macro("printf")
+#endif
