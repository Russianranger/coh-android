-static int armportZoneTraceQuietDrops(const char *stage)
+static int armportZoneTraceIsMapFile(const char *detail)
+{
+    /* "maps/" anywhere in the path, in any case: a map file or one of its layers.
+     * Object library paths ("object_library/...") never hold it. */
+    const char *p;
+    if (!detail) return 0;
+    for (p = detail; *p; ++p)
+        if ((p[0] | 32) == 'm' && (p[1] | 32) == 'a' && (p[2] | 32) == 'p' && (p[3] | 32) == 's'
+            && (p[4] == '/' || p[4] == '\\'))
+            return 1;
+    return 0;
+}
+
+static int armportZoneTraceQuietDrops(const char *stage, const char *detail)
 {
     /* ARMPORT_TRACE_QUIET (device play): keep only load boundaries, errors
      * and dialogs. Per-file library/texture/model records cost load time on
@@ -96,12 +109,15 @@ static int armportZoneTraceQuietDrops(const char *stage)
     if (!quiet) return 0;
     for (i = 0; i < sizeof(keep) / sizeof(keep[0]); ++i)
         if (!strncmp(stage, keep[i], strlen(keep[i]))) return 0;
+    /* 0.13.80 (patch 0131): the map file and its layers, a handful per load, also keep
+     * their four "library." records; the object library's hundreds stay dropped. */
+    if (!strncmp(stage, "library.", 8) && armportZoneTraceIsMapFile(detail)) return 0;
     return 1;
 }
 
