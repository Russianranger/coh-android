+#ifdef COH_ARMPORT_REPLAY
+/* Read only: retained packet/event response destinations, not UI widgets or
+ * local request/queue clocks. Called only by active replay snapshots. */
+void armportReplayTurnstileEventState(ArmPortTurnstileEventState *state)
+{
+    state->name = event_name;
+    state->name_capacity = sizeof(event_name);
+    state->response_expected = eventResponseExpected;
+    state->accepted_count = event_acceptedCount;
+    state->declined_count = event_declinedCount;
+    state->in_progress = event_inProgress;
+    state->player_count = event_playerCount;
+    state->instance_id = event_instanceID;
+    state->status_player_count = status_playerCount;
+    state->replied[0] = status_replied1;
+    state->replied[1] = status_replied2;
+    state->status[0] = status_status1;
+    state->status[1] = status_status2;
+}
+#endif
