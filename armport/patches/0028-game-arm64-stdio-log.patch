diff --git a/Game/src/win/win_init.c b/Game/src/win/win_init.c
index d943574..27e3fe7 100644
--- a/Game/src/win/win_init.c
+++ b/Game/src/win/win_init.c
@@ -2104,6 +2104,21 @@ int WINAPI WinMain ( HINSTANCE hInstance, HINSTANCE hPrevInstance,
     int        noExceptionHandler=0;
     FILE    *file;
 
+#if defined(__aarch64__) && defined(__MINGW32__)
+    {
+        // ArmPort: a GUI program has no usable stdout/stderr under Wine; when
+        // ARMPORT_STDIO_LOG names a file, send both there (diagnostics only).
+        const char *armportLog = getenv("ARMPORT_STDIO_LOG");
+        if (armportLog && *armportLog && freopen(armportLog, "a", stdout))
+        {
+            // One file descriptor for both streams, so writes do not overlap.
+            _dup2(_fileno(stdout), _fileno(stderr));
+            setvbuf(stdout, NULL, _IONBF, 0);
+            setvbuf(stderr, NULL, _IONBF, 0);
+        }
+    }
+#endif
+
     memCheckInit();
 
     argv[0] = windowName;
diff --git a/libs/UtilitiesLib/src/utils/utils.c b/libs/UtilitiesLib/src/utils/utils.c
index 7f3d803..94afca7 100644
--- a/libs/UtilitiesLib/src/utils/utils.c
+++ b/libs/UtilitiesLib/src/utils/utils.c
@@ -449,6 +449,12 @@ static void fixStdio(int fh, DWORD std_handle)
 void newConsoleWindow()
 {
     g_isConsoleOpen = true;
+#if defined(__aarch64__) && defined(__MINGW32__)
+    // ArmPort: stdout/stderr already go to ARMPORT_STDIO_LOG (win_init.c);
+    // do not move them to a console window.
+    if (getenv("ARMPORT_STDIO_LOG"))
+        return;
+#endif
 
     if(isGuiDisabled() || IsUsingCider()) return;
 
