diff --git a/Game/src/clientcomm/clientcomm.c b/Game/src/clientcomm/clientcomm.c
index 6c7c0f2..4e0fcfb 100644
--- a/Game/src/clientcomm/clientcomm.c
+++ b/Game/src/clientcomm/clientcomm.c
@@ -829,10 +829,20 @@ void commGetStats(NetLink *link, Packet* pak)
 void commServerWaitOK(char* mapname)
 {
     Packet    *pak;
+
+    /* ArmPort evidence (patch 0135): the client's side of a zone transfer, in the same
+     * tick-stamped stream as the load boundaries. "xfer.wait": the source zone put up the
+     * load screen; "xfer.address": the new zone's address arrived; "xfer.disconnected": the
+     * old link is closed (netSendDisconnect waits up to 5 s for the old zone's answer);
+     * "xfer.connect.begin"/"xfer.connected"/"xfer.scene.done": doMapXfer. CI run 45187469113:
+     * the game had its new world 3.7 s after the zone server was ready, and nothing recorded
+     * says where that goes. No packet, wait or order changes. */
 #ifndef TEST_CLIENT
     int index;
 #endif
 
+    armportZoneTrace("xfer.wait", mapname);
+
     // show load screen immediately
     g_showMapLoadingMessage = false;
     game_state.game_mode = SHOW_LOAD_SCREEN;
@@ -883,12 +893,14 @@ void commServerMapXfer(Packet *pak_in)
     Packet    *pak;
 
     g_showMapLoadingMessage = false;   /* ArmPort (patch 0125): moving on, the wait is over */
+    armportZoneTrace("xfer.address", NULL);
     dbOrMapConnect(pak_in);
     pak = pktCreate();
     pktSendBitsPack(pak,1,CLIENT_MAP_XFER_ACK);
     pktSend(&pak,&comm_link);
     lnkBatchSend(&comm_link);
     netSendDisconnect(&comm_link,5.f);
+    armportZoneTrace("xfer.disconnected", NULL);
     lastTotalBytesRead = 0;
 
     {
