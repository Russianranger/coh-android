diff --git a/Game/src/entity/armport_net_clock.h b/Game/src/entity/armport_net_clock.h
new file mode 100644
index 0000000..f666811
--- /dev/null
+++ b/Game/src/entity/armport_net_clock.h
@@ -0,0 +1,64 @@
+/* ArmPort: entity interpolation clock (patch 0123).
+ *
+ * entrecv.c keeps local_time_bias (U32) so that the client's own clock plus
+ * the bias tracks the server's abs_time, and draws other entities at
+ * client_abs, auto_delay seconds behind the newest update. When the server is
+ * younger than the client's clock (a zone server started after the client,
+ * such as King's Row reached by monorail), the bias is "negative" modulo 2^32.
+ * x86 converts a negative float to U32 modulo 2^32 (through a 64-bit
+ * conversion), which the code relies on. AArch64 FCVTZU saturates a negative
+ * value to 0, so the bias stayed at 0, client_abs was clamped to the newest
+ * update and NPCs, cars and trains jumped from update to update instead of
+ * moving smoothly. armportWrapFloatToU32 is the x86 conversion on both.
+ *
+ * Game/UtilitiesLib headers redefine printf/fflush; the log helper isolates
+ * those macros like armport_frame_rate_log.h (patch 0114).
+ */
+#ifndef ARMPORT_NET_CLOCK_H
+#define ARMPORT_NET_CLOCK_H
+#pragma push_macro("printf")
+#pragma push_macro("snprintf")
+#pragma push_macro("fflush")
+#pragma push_macro("fputs")
+#pragma push_macro("FILE")
+#undef printf
+#undef snprintf
+#undef fflush
+#undef fputs
+#undef FILE
+#include <stdio.h>
+#include <stdlib.h>
+
+static __inline unsigned int armportWrapFloatToU32(float value)
+{
+    return (unsigned int)(long long)value;
+}
+
+static int armportNetClockLogEnabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *value = getenv("ARMPORT_NET_CLOCK_LOG");
+        enabled = value && value[0] == '1' && value[1] == 0;
+    }
+    return enabled;
+}
+
+/* abs_time units are 1/3000 s, so units / 3 is milliseconds. */
+static void armportNetClockLogWrite(unsigned int bias, unsigned int server_abs, unsigned int client_abs,
+                                    float delay, float elapsed)
+{
+    char line[200];
+    snprintf(line, sizeof(line),
+        "ARMPORT_NET_CLOCK_V1 bias=%u server_abs=%u client_abs=%u lag_ms=%d delay_ms=%d elapsed_s=%.1f\n",
+        bias, server_abs, client_abs, (int)(server_abs - client_abs) / 3, (int)(delay * 1000.f), elapsed);
+    fputs(line, stdout);
+    fflush(stdout);
+}
+
+#pragma pop_macro("FILE")
+#pragma pop_macro("fputs")
+#pragma pop_macro("fflush")
+#pragma pop_macro("snprintf")
+#pragma pop_macro("printf")
+#endif
