diff --git a/Game/src/clientcomm/armport_replay.h b/Game/src/clientcomm/armport_replay.h
new file mode 100644
index 0000000..5ed991e
--- /dev/null
+++ b/Game/src/clientcomm/armport_replay.h
@@ -0,0 +1,18 @@
+#pragma once
+
+// Test-only original-receiver entry. Inert unless ARMPORT_REPLAY_DIR is set.
+// After normal game_beforeLoop startup, replay additionally calls
+// entReceiveInit (map-move receive reset), commNewInputPak (per-record output
+// isolation), and setAssertMode (stderr + exit). No hand-built entity/world
+// initialization replaces normal startup. See armport/replay/receiver.c.
+#if (defined(__aarch64__) && defined(__MINGW32__)) || defined(COH_ARMPORT_REFERENCE_I686)
+#define COH_ARMPORT_REPLAY 1
+typedef struct Packet Packet;
+typedef struct NetLink NetLink;
+void armportReplayMaybeRun(void);
+void armportReplayUnknownCommand(int command);
+int commArmPortReplayDispatch(Packet *pak, int command, NetLink *link);
+#else
+#define armportReplayMaybeRun() ((void)0)
+#define armportReplayUnknownCommand(command) ((void)0)
+#endif
