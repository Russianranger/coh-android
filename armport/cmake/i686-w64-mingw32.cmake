# Original-client 32-bit replay comparison, never a shipping app target.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)
if(NOT DEFINED ENV{COH_LLVM_MINGW})
    message(FATAL_ERROR "Set COH_LLVM_MINGW to the pinned llvm-mingw toolchain")
endif()
set(_coh_prefix "$ENV{COH_LLVM_MINGW}/bin/i686-w64-mingw32-")
set(CMAKE_C_COMPILER "${_coh_prefix}clang")
set(CMAKE_CXX_COMPILER "${_coh_prefix}clang++")
set(CMAKE_RC_COMPILER "${_coh_prefix}windres")
set(CMAKE_AR "$ENV{COH_LLVM_MINGW}/bin/llvm-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "$ENV{COH_LLVM_MINGW}/bin/llvm-ranlib" CACHE FILEPATH "")
set(CMAKE_FIND_ROOT_PATH "$ENV{COH_LLVM_MINGW}/i686-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(COX_ARMPORT_REFERENCE_I686 ON CACHE BOOL "Replay reference only" FORCE)
if(DEFINED ENV{COH_WINE})
    set(CMAKE_CROSSCOMPILING_EMULATOR "$ENV{COH_WINE}" CACHE STRING "" FORCE)
endif()
