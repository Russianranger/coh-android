+/**
+ * PROOT_ACCEPT_UNTRACED=1: do not trace accept(2) and accept4(2).
+ *
+ * PRoot stops them only to rewrite, at exit, the path in the peer
+ * address of a Unix socket (a client that bound its socket to a path
+ * under a binding or the guest rootfs).  A server that polls its
+ * listening sockets pays two tracer round trips per call for that:
+ * a Wine prefix with two game servers made 1,340 such calls a second.
+ * With the switch the peer's path is returned as the kernel holds it,
+ * that is, as a host path.
+ */
+static bool accept_untraced(void)
+{
+	const char *value = getenv("PROOT_ACCEPT_UNTRACED");
+	return value != NULL && value[0] == '1' && value[1] == '\0';
+}
