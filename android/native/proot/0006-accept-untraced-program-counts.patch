 } stop_counts;
 
+/**
+ * The row in stop_counts.programs of the name of thread @pid.
+ */
+static inline unsigned int stop_counts_program(pid_t pid)
+{
+	unsigned int slot = (unsigned int) pid % STOP_COUNTS_THREADS;
+	char path[40];
+	char name[16];
+	ssize_t length;
+	int fd;
+	int i;
+
+	if (stop_counts.threads[slot].pid == pid && ++stop_counts.threads[slot].age != 0)
+		return stop_counts.threads[slot].program;
+
+	snprintf(path, sizeof(path), "/proc/%d/comm", (int) pid);
+	length = -1;
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd >= 0) {
+		length = read(fd, name, sizeof(name) - 1);
+		close(fd);
+	}
+	if (length <= 0) {
+		memcpy(name, "(unknown)", 10);
+		length = 9;
+	}
+	name[length] = '\0';
+	for (i = 0; i < length; i++) {
+		if (name[i] == '\n')
+			name[i] = '\0';
+		else if (name[i] <= ' ' || name[i] > '~')
+			name[i] = '_';
+	}
+
+	for (i = 0; i < stop_counts.nb_programs; i++) {
+		if (strcmp(stop_counts.programs[i], name) == 0)
+			break;
+	}
+	if (i == stop_counts.nb_programs) {
+		if (i == STOP_COUNTS_PROGRAMS - 1)
+			memcpy(name, "(other)", 8);
+		if (i < STOP_COUNTS_PROGRAMS) {
+			memcpy(stop_counts.programs[i], name, sizeof(name));
+			stop_counts.nb_programs++;
+		}
+		else
+			i = STOP_COUNTS_PROGRAMS - 1;
+	}
+
+	stop_counts.threads[slot].pid = pid;
+	stop_counts.threads[slot].program = (unsigned char) i;
+	stop_counts.threads[slot].age = 0;
+	return (unsigned int) i;
+}
+
+/**
+ * Count one stop of the thread @pid at syscall row @index.
+ */
+static inline void stop_counts_pair(pid_t pid, size_t index)
+{
+	uint32_t key = ((uint32_t) (stop_counts_program(pid) + 1) << 16) | (uint32_t) index;
+	uint32_t slot = (key * 2654435761u) >> 20;	/* 12 bits: STOP_COUNTS_PAIRS */
+	int probe;
+
+	for (probe = 0; probe < STOP_COUNTS_PROBES; probe++) {
+		uint32_t at = (slot + (uint32_t) probe) % STOP_COUNTS_PAIRS;
+
+		if (stop_counts.pairs[at].key == 0)
+			stop_counts.pairs[at].key = key;
+		if (stop_counts.pairs[at].key == key) {
+			stop_counts.pairs[at].stops++;
+			return;
+		}
+	}
+}
