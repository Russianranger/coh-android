diff --git a/src/syscall/socket_fd_filter.h b/src/syscall/socket_fd_filter.h
new file mode 100644
index 0000000..5ac53f0
--- /dev/null
+++ b/src/syscall/socket_fd_filter.h
@@ -0,0 +1,78 @@
+/* -*- c-set-style: "K&R"; c-basic-offset: 8 -*-
+ *
+ * Trace sendto(2), recvfrom(2) and recvmsg(2) only for descriptors
+ * that can be a rtnetlink socket.
+ *
+ * PRoot asks for these three calls for one purpose: to answer the
+ * rtnetlink requests of a tracee whose host refuses AF_NETLINK
+ * (syscall/enter.c, "Helpers for emulating AF_NETLINK"), and to ack
+ * the requests of a tracee that believes it owns a network namespace.
+ * Both look the descriptor up in a short per-tracee list and do
+ * nothing for any other socket, yet every send and receive of every
+ * socket of the guest pays a tracer round trip for that lookup.
+ *
+ * With PROOT_NETLINK_HIGH_FDS=1 PRoot gives each NETLINK_ROUTE socket
+ * a descriptor number at or above SOCKET_FD_FLOOR (it duplicates the
+ * new socket there and closes the low number before socket(2)
+ * returns), and the seccomp filter notifies the tracer about the
+ * three calls only for descriptors at or above that number.  A socket
+ * of another kind that happens to sit that high is traced as before,
+ * which costs time and changes nothing.
+ *
+ * This file is self-contained (no talloc, no PRoot types) so that the
+ * statements can be checked on any host by a test harness.
+ */
+
+#ifndef SOCKET_FD_FILTER_H
+#define SOCKET_FD_FILTER_H
+
+#include <linux/filter.h>  /* struct sock_filter, BPF_*, */
+#include <linux/seccomp.h> /* struct seccomp_data, SECCOMP_RET_*, */
+#include <stddef.h>        /* offsetof(3), size_t, */
+#include <stdint.h>        /* uint32_t, */
+
+/* Below FD_SETSIZE (1024) and below the lowest soft RLIMIT_NOFILE in
+ * common use (1024), above what a guest program normally has open.  */
+#define SOCKET_FD_FLOOR 960
+
+/* Statements written by socket_fd_filter_statements().  */
+#define LENGTH_TRACE_SOCKET_FD 5
+
+/**
+ * Write to @out (LENGTH_TRACE_SOCKET_FD items) the statements that
+ * notify the tracer, with the given @flag, about @syscall (sendto,
+ * recvfrom or recvmsg on the current architecture) when its first
+ * argument, the descriptor, is at or above SOCKET_FD_FLOOR, and allow
+ * it otherwise.
+ *
+ * On entry the accumulator holds the syscall number.  It is untouched
+ * unless that number is @syscall, so the statements that follow see it
+ * as before; when it is @syscall every path returns.
+ *
+ *	0:  if (nr != syscall) goto after;
+ *	1:  A = low word of the first argument (the descriptor);
+ *	2:  if (A >= SOCKET_FD_FLOOR) goto trace;
+ *	3:  return ALLOW;
+ *	4:  trace: return TRACE + flag;
+ *	after:
+ *
+ * The comparison is unsigned, so a negative descriptor (which the
+ * kernel refuses anyway) is traced.
+ */
+static inline size_t socket_fd_filter_statements(struct sock_filter *out, uint32_t syscall, uint32_t flag)
+{
+	/* seccomp_data.args[] are 64-bit; the descriptor is an int in
+	 * the low word.  PRoot's handled architectures are
+	 * little-endian.  */
+	const uint32_t fd_offset = offsetof(struct seccomp_data, args[0]);
+
+	out[0] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, syscall, 0, 4);
+	out[1] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, fd_offset);
+	out[2] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JGE + BPF_K, SOCKET_FD_FLOOR, 1, 0);
+	out[3] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW);
+	out[4] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_TRACE + flag);
+
+	return LENGTH_TRACE_SOCKET_FD;
+}
+
+#endif /* SOCKET_FD_FILTER_H */
