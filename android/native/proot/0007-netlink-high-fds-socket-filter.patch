+ * Not when an extension asks for one of these calls itself (-p,
+ * port_switch): it needs every one of them.  The tracer and the
+ * process that installs the filter both decide with this function, so
+ * they agree.
+ */
+bool netlink_high_fds(const Tracee *tracee)
+{
+	const char *value = getenv("PROOT_NETLINK_HIGH_FDS");
+	const Extension *extension;
+	size_t i;
+
+	if (value == NULL || value[0] != '1' || value[1] != '\0')
+		return false;
+
+	if (tracee == NULL || tracee->extensions == NULL)
+		return true;
+
+	LIST_FOREACH(extension, tracee->extensions, link) {
+		if (extension->filtered_sysnums == NULL)
+			continue;
+		for (i = 0; extension->filtered_sysnums[i].value != PR_void; i++) {
+			if (is_netlink_only_sysnum(extension->filtered_sysnums[i].value))
+				return false;
+		}
