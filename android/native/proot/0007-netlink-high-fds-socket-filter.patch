+ * rtnetlink sockets (see socket_fd_filter.h).
+ */
+static bool is_netlink_only_sysnum(Sysnum sysnum)
+{
+	return sysnum == PR_sendto || sysnum == PR_recvfrom || sysnum == PR_recvmsg;
+}
+
+/**
+ * PROOT_NETLINK_HIGH_FDS=1: whether the rtnetlink sockets of @tracee
+ * get descriptor numbers at or above SOCKET_FD_FLOOR and the seccomp
+ * filter traces sendto(2), recvfrom(2) and recvmsg(2) from that
+ * number only (see socket_fd_filter.h).
