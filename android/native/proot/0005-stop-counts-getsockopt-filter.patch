 	return add_statements(program, LENGTH_TRACE_IOCTL, statements);
 }
 
+/**
+ * PROOT_GETSOCKOPT_PEERCRED_ONLY=1: trace getsockopt(2) only for
+ * SOL_SOCKET/SO_PEERCRED (see getsockopt_filter.h).
+ */
+static bool getsockopt_peercred_only(void)
+{
+	const char *value = getenv("PROOT_GETSOCKOPT_PEERCRED_ONLY");
+	return value != NULL && value[0] == '1' && value[1] == '\0';
+}
+
+/**
+ * Append to @program->filter the statements required to notify PRoot
+ * about the given @syscall (getsockopt) with the given @flag, only for
+ * the option of getsockopt_filter.h.  This function returns -errno if
+ * an error occurred, otherwise 0.
+ */
+static int add_trace_getsockopt_peercred(struct sock_fprog *program, word_t syscall, int flag)
+{
+	struct sock_filter statements[LENGTH_TRACE_GETSOCKOPT];
+
+	/* Sanity check.  */
+	if (syscall > UINT32_MAX)
+		return -ERANGE;
+
+	getsockopt_filter_statements(statements, syscall, flag);
+
+	DEBUG_FILTER("FILTER:     trace if syscall == %ld and it asks for SO_PEERCRED\n", syscall);
+
+	return add_statements(program, LENGTH_TRACE_GETSOCKOPT, statements);
+}
+
 /**
  * Append to @program->filter the statements that allow anything (if
  * unfiltered).  Note that @nb_traced_syscalls and @nb_extra_statements
@@ -295,6 +327,7 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 
 	struct sock_fprog program = { .len = 0, .filter = NULL };
 	const bool commands_only = ioctl_commands_only();
+	const bool peercred_only = getsockopt_peercred_only();
 	size_t nb_traced_syscalls;
 	size_t nb_extra_statements;
 	size_t i, j, k;
@@ -320,6 +353,8 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
