diff --git a/src/syscall/getsockopt_filter.h b/src/syscall/getsockopt_filter.h
new file mode 100644
index 0000000..16f19dc
--- /dev/null
+++ b/src/syscall/getsockopt_filter.h
@@ -0,0 +1,70 @@
+/* -*- c-set-style: "K&R"; c-basic-offset: 8 -*-
+ *
+ * Trace getsockopt(2) only for the option PRoot rewrites.
+ *
+ * The fake_id0 extension (-0, -i) asks for getsockopt(2) on exit to
+ * replace the peer's ids in a SOL_SOCKET/SO_PEERCRED answer
+ * (extension/fake_id0/getsockopt.c).  It ignores every other level
+ * and option, yet a guest that asks a socket for SO_ERROR, SO_TYPE or
+ * its buffer sizes pays two tracer round trips each time.  With
+ * PROOT_GETSOCKOPT_PEERCRED_ONLY=1 the seccomp filter compares the
+ * level and the option (second and third arguments) and notifies the
+ * tracer only for that one pair.
+ *
+ * This file is self-contained (no talloc, no PRoot types) so that the
+ * statements can be checked on any host by a test harness.
+ */
+
+#ifndef GETSOCKOPT_FILTER_H
+#define GETSOCKOPT_FILTER_H
+
+#include <linux/filter.h>  /* struct sock_filter, BPF_*, */
+#include <linux/seccomp.h> /* struct seccomp_data, SECCOMP_RET_*, */
+#include <stddef.h>        /* offsetof(3), size_t, */
+#include <stdint.h>        /* uint32_t, */
+
+/* Literal values (asm-generic, the same on arm64, arm and x86).  */
+#define GETSOCKOPT_FILTER_LEVEL  1	/* SOL_SOCKET */
+#define GETSOCKOPT_FILTER_OPTION 17	/* SO_PEERCRED */
+
+/* Statements written by getsockopt_filter_statements().  */
+#define LENGTH_TRACE_GETSOCKOPT 7
+
+/**
+ * Write to @out (LENGTH_TRACE_GETSOCKOPT items) the statements that
+ * notify the tracer, with the given @flag, about @syscall (getsockopt
+ * on the current architecture) when it asks for SOL_SOCKET/SO_PEERCRED,
+ * and allow it otherwise.
+ *
+ * On entry the accumulator holds the syscall number.  It is untouched
+ * unless that number is @syscall, so the statements that follow see it
+ * as before; when it is @syscall every path returns.
+ *
+ *	0:  if (nr != syscall) goto after;
+ *	1:  A = low word of the second argument (the level);
+ *	2:  if (A != SOL_SOCKET) goto allow;
+ *	3:  A = low word of the third argument (the option);
+ *	4:  if (A == SO_PEERCRED) goto trace;
+ *	5:  allow: return ALLOW;
+ *	6:  trace: return TRACE + flag;
+ *	after:
+ */
+static inline size_t getsockopt_filter_statements(struct sock_filter *out, uint32_t syscall, uint32_t flag)
+{
+	/* seccomp_data.args[] are 64-bit; both arguments are ints in the
+	 * low word.  PRoot's handled architectures are little-endian.  */
+	const uint32_t level_offset  = offsetof(struct seccomp_data, args[1]);
+	const uint32_t option_offset = offsetof(struct seccomp_data, args[2]);
+
+	out[0] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, syscall, 0, 6);
+	out[1] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, level_offset);
+	out[2] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, GETSOCKOPT_FILTER_LEVEL, 0, 2);
+	out[3] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, option_offset);
+	out[4] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, GETSOCKOPT_FILTER_OPTION, 1, 0);
+	out[5] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW);
+	out[6] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_TRACE + flag);
+
+	return LENGTH_TRACE_GETSOCKOPT;
+}
+
+#endif /* GETSOCKOPT_FILTER_H */
diff --git a/src/syscall/seccomp.c b/src/syscall/seccomp.c
index 6ba7508..c4690b0 100644
--- a/src/syscall/seccomp.c
