 				if (commands_only && sysnums[k].value == PR_ioctl)
 					nb_extra_statements += LENGTH_TRACE_IOCTL - LENGTH_TRACE_SYSCALL;
+				if (peercred_only && sysnums[k].value == PR_getsockopt)
+					nb_extra_statements += LENGTH_TRACE_GETSOCKOPT - LENGTH_TRACE_SYSCALL;
 			}
 		}
 
@@ -339,6 +374,8 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 				/* Filter: trace if handled syscall */
 				if (commands_only && sysnums[k].value == PR_ioctl)
 					status = add_trace_ioctl_commands(&program, syscall, sysnums[k].flags);
+				else if (peercred_only && sysnums[k].value == PR_getsockopt)
+					status = add_trace_getsockopt_peercred(&program, syscall, sysnums[k].flags);
 				else
 					status = add_trace_syscall(&program, syscall, sysnums[k].flags);
 				if (status < 0)
diff --git a/src/syscall/stop_counts.h b/src/syscall/stop_counts.h
new file mode 100644
index 0000000..8fb7b34
--- /dev/null
+++ b/src/syscall/stop_counts.h
@@ -0,0 +1,126 @@
+/* -*- c-set-style: "K&R"; c-basic-offset: 8 -*-
+ *
+ * Count the syscall stops PRoot serves, per syscall number.
+ *
+ * Every traced syscall stops its thread until PRoot's one thread has
+ * served it, so the number of stops per syscall says where a guest's
+ * time under PRoot goes.  With PROOT_STOP_COUNTS=<file> PRoot counts
+ * each translation round (enter and exit apart) and writes the table
+ * to <file>, replacing it atomically, about every ten seconds while
+ * stops arrive and once more when it exits.  Without the variable
+ * nothing is counted and nothing is written.
+ *
+ * The file is text:
+ *
+ *	PROOT_STOP_COUNTS_V1 seconds=<since first stop> stops=<total>
+ *	<syscall number> <enter stops> <exit stops>
+ *	...
+ *
+ * Numbers are those of the tracee's ABI as the kernel reported them;
+ * numbers at or above STOP_COUNTS_SYSCALLS share the last row.
+ */
+
+#ifndef STOP_COUNTS_H
+#define STOP_COUNTS_H
+
+#include <limits.h>   /* PATH_MAX, */
+#include <stdbool.h>  /* bool, */
+#include <stdint.h>   /* uint64_t, */
+#include <stdio.h>    /* fopen(3), fprintf(3), rename(2), */
+#include <stdlib.h>   /* getenv(3), atexit(3), */
+#include <string.h>   /* strlen(3), */
+#include <time.h>     /* clock_gettime(2), */
+
+#define STOP_COUNTS_SYSCALLS 512
+#define STOP_COUNTS_PERIOD_SECONDS 10
+
+static struct {
+	int state;	/* 0: not looked up yet, 1: counting, -1: off.  */
+	char path[PATH_MAX];
+	char temporary[PATH_MAX + 8];
+	uint64_t enter[STOP_COUNTS_SYSCALLS + 1];
+	uint64_t exit[STOP_COUNTS_SYSCALLS + 1];
+	uint64_t total;
+	time_t started;
+	time_t written;
+} stop_counts;
+
+static inline time_t stop_counts_now(void)
+{
+	struct timespec now;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+		return 0;
+	return now.tv_sec;
+}
+
+static inline void stop_counts_write(void)
+{
+	FILE *file;
+	int i;
+
+	if (stop_counts.state != 1)
+		return;
+
+	file = fopen(stop_counts.temporary, "w");
+	if (file == NULL)
+		return;
+
+	fprintf(file, "PROOT_STOP_COUNTS_V1 seconds=%lld stops=%llu\n",
+		(long long) (stop_counts_now() - stop_counts.started),
+		(unsigned long long) stop_counts.total);
+	for (i = 0; i <= STOP_COUNTS_SYSCALLS; i++) {
+		if (stop_counts.enter[i] == 0 && stop_counts.exit[i] == 0)
+			continue;
+		fprintf(file, "%d %llu %llu\n", i,
+			(unsigned long long) stop_counts.enter[i],
+			(unsigned long long) stop_counts.exit[i]);
+	}
+
+	if (fclose(file) == 0)
+		(void) rename(stop_counts.temporary, stop_counts.path);
+}
+
+/**
+ * Count one translation round of syscall @number, at the enter stage
+ * if @is_enter, otherwise at the exit stage.
+ */
+static inline void stop_counts_note(unsigned long number, bool is_enter)
+{
+	size_t index;
+
+	if (stop_counts.state == 0) {
+		const char *path = getenv("PROOT_STOP_COUNTS");
+		size_t length = path != NULL ? strlen(path) : 0;
+
+		if (length == 0 || length >= sizeof(stop_counts.path)) {
+			stop_counts.state = -1;
+			return;
+		}
+		memcpy(stop_counts.path, path, length + 1);
+		snprintf(stop_counts.temporary, sizeof(stop_counts.temporary), "%s.new", path);
+		stop_counts.started = stop_counts.written = stop_counts_now();
+		stop_counts.state = 1;
+		atexit(stop_counts_write);
+	}
+	if (stop_counts.state != 1)
+		return;
+
+	index = number < STOP_COUNTS_SYSCALLS ? number : STOP_COUNTS_SYSCALLS;
+	if (is_enter)
+		stop_counts.enter[index]++;
+	else
+		stop_counts.exit[index]++;
+
+	/* Look at the clock once in 256 stops only.  */
+	if ((++stop_counts.total & 255) == 0) {
+		time_t now = stop_counts_now();
+
+		if (now - stop_counts.written >= STOP_COUNTS_PERIOD_SECONDS) {
+			stop_counts.written = now;
+			stop_counts_write();
+		}
+	}
+}
+
+#endif /* STOP_COUNTS_H */
