index 0000000..52e53c9
--- /dev/null
+++ b/src/syscall/ioctl_filter.h
@@ -0,0 +1,81 @@
+/* -*- c-set-style: "K&R"; c-basic-offset: 8 -*-
+ *
+ * Trace ioctl(2) only for the commands PRoot rewrites or answers.
+ *
+ * PRoot's Android builds trace every ioctl(2), on entry and on exit, to
+ * fix up a few terminal commands, SIOCGIFINDEX and FICLONE (enter.c,
+ * exit.c).  A guest that renders through a GPU driver, or polls
+ * sockets and devices, pays two tracer round trips for each of its
+ * other ioctls and gains nothing.  With PROOT_IOCTL_COMMANDS_ONLY=1
+ * the seccomp filter compares the command (the second argument) and
+ * notifies the tracer only for the commands listed here; every other
+ * ioctl runs untraced, exactly as it does for the kernel.
+ *
+ * This file is self-contained (no talloc, no PRoot types) so that the
+ * statements can be checked on any host by a test harness.
+ */
+
+#ifndef IOCTL_FILTER_H
+#define IOCTL_FILTER_H
+
+#include <linux/filter.h>  /* struct sock_filter, BPF_*, */
+#include <linux/seccomp.h> /* struct seccomp_data, SECCOMP_RET_*, */
+#include <stddef.h>        /* offsetof(3), size_t, */
+#include <stdint.h>        /* uint32_t, */
+
+/* The commands enter.c and exit.c act on.  Literal values (asm-generic,
+ * the same on arm64, arm and x86): enter.c compares TCSETS + 2 literally
+ * for the same reason.  Keep this list in step with those two files.  */
+static const uint32_t ioctl_filter_commands[] = {
+	0x8933,		/* SIOCGIFINDEX: answered by the tracer.  */
+	0x5404,		/* TCSETS + 2 (TCSETSF): rewritten to TCSETS.  */
+	0x802C542A,	/* TCGETS2: rewritten to TCGETS.  */
+	0x402C542B,	/* TCSETS2: rewritten to TCSETS.  */
+	0x402C542C,	/* TCSETSW2: rewritten to TCSETSW.  */
+	0x402C542D,	/* TCSETSF2: rewritten to TCSETS.  */
+	0x40049409,	/* FICLONE: -EACCES becomes -EOPNOTSUPP on exit.  */
+};
+
+#define IOCTL_FILTER_COMMAND_COUNT \
+	(sizeof(ioctl_filter_commands) / sizeof(ioctl_filter_commands[0]))
+
+/* Statements written by ioctl_filter_statements().  */
+#define LENGTH_TRACE_IOCTL (IOCTL_FILTER_COMMAND_COUNT + 4)
+
+/**
+ * Write to @out (LENGTH_TRACE_IOCTL items) the statements that notify
+ * the tracer, with the given @flag, about @syscall (ioctl on the
+ * current architecture) when its command is one of
+ * ioctl_filter_commands[], and allow it otherwise.
+ *
+ * On entry the accumulator holds the syscall number.  It is untouched
+ * unless that number is @syscall, so the statements that follow see it
+ * as before; when it is @syscall every path returns.
+ *
+ *	0:       if (nr != syscall) goto after;
+ *	1:       A = low word of the second argument (the command);
+ *	2..K+1:  if (A == command[i]) goto trace;
+ *	K+2:     return ALLOW;
+ *	K+3:     trace: return TRACE + flag;
+ *	after:
+ */
+static inline size_t ioctl_filter_statements(struct sock_filter *out, uint32_t syscall, uint32_t flag)
+{
+	const size_t count = IOCTL_FILTER_COMMAND_COUNT;
+	/* seccomp_data.args[] are 64-bit; the command is an unsigned int in
+	 * the low word.  PRoot's handled architectures are little-endian.  */
+	const uint32_t command_offset = offsetof(struct seccomp_data, args[1]);
+	size_t i;
+
+	out[0] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, syscall, 0, count + 3);
+	out[1] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, command_offset);
+	for (i = 0; i < count; i++)
+		out[2 + i] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K,
+							   ioctl_filter_commands[i], count - i, 0);
+	out[count + 2] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW);
+	out[count + 3] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_TRACE + flag);
+
+	return LENGTH_TRACE_IOCTL;
+}
+
+#endif /* IOCTL_FILTER_H */
