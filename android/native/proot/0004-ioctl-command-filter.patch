 	/* Sanity checks.  */
@@ -256,7 +294,9 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 	size_t nb_archs = sizeof(seccomp_archs) / sizeof(SeccompArch);
 
 	struct sock_fprog program = { .len = 0, .filter = NULL };
+	const bool commands_only = ioctl_commands_only();
 	size_t nb_traced_syscalls;
+	size_t nb_extra_statements;
 	size_t i, j, k;
 	int status;
 
@@ -269,18 +309,23 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 		word_t syscall;
 
 		nb_traced_syscalls = 0;
+		nb_extra_statements = 0;
 
