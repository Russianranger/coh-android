+				nb_traced_syscalls++;
+				if (commands_only && sysnums[k].value == PR_ioctl)
+					nb_extra_statements += LENGTH_TRACE_IOCTL - LENGTH_TRACE_SYSCALL;
 			}
 		}
 
 		/* Filter: if handled architecture */
-		status = start_arch_section(&program, seccomp_archs[i].value, nb_traced_syscalls);
+		status = start_arch_section(&program, seccomp_archs[i].value, nb_traced_syscalls,
+					nb_extra_statements);
 		if (status < 0)
 			goto end;
 
@@ -292,14 +337,17 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 					continue;
 
 				/* Filter: trace if handled syscall */
-				status = add_trace_syscall(&program, syscall, sysnums[k].flags);
+				if (commands_only && sysnums[k].value == PR_ioctl)
+					status = add_trace_ioctl_commands(&program, syscall, sysnums[k].flags);
+				else
+					status = add_trace_syscall(&program, syscall, sysnums[k].flags);
 				if (status < 0)
 					goto end;
 			}
 		}
 
 		/* Filter: allow untraced syscalls for this architecture */
-		status = end_arch_section(&program, nb_traced_syscalls);
+		status = end_arch_section(&program, nb_traced_syscalls, nb_extra_statements);
 		if (status < 0)
 			goto end;
 	}
@@ -515,6 +563,21 @@ int enable_syscall_filtering(const Tracee *tracee)
 		}
 	}
 
+	/* With the command filter, ioctl(2) is in the list on every
+	 * platform (Android builds already have it): only the handled
+	 * commands reach the tracer, so this costs other guests nothing
+	 * and the same statements run wherever PRoot is tested.  */
+	if (ioctl_commands_only()) {
+		static const FilteredSysnum ioctl_sysnums[] = {
+			{ PR_ioctl,		FILTER_SYSEXIT },
+			FILTERED_SYSNUM_END
+		};
+
+		status = merge_filtered_sysnums(tracee->ctx, &filtered_sysnums, ioctl_sysnums);
+		if (status < 0)
+			return status;
+	}
+
 	status = set_seccomp_filters(filtered_sysnums);
 	if (status < 0)
 		return status;
