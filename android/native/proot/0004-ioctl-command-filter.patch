+/**
+ * PROOT_IOCTL_COMMANDS_ONLY=1: trace ioctl(2) only for the commands
+ * PRoot acts on (see ioctl_filter.h).
+ */
+static bool ioctl_commands_only(void)
+{
+	const char *value = getenv("PROOT_IOCTL_COMMANDS_ONLY");
+	return value != NULL && value[0] == '1' && value[1] == '\0';
+}
+
+/**
+ * Append to @program->filter the statements required to notify PRoot
+ * about the given @syscall (ioctl) with the given @flag, only for the
+ * commands of ioctl_filter.h.  This function returns -errno if an
+ * error occurred, otherwise 0.
+ */
+static int add_trace_ioctl_commands(struct sock_fprog *program, word_t syscall, int flag)
+{
+	struct sock_filter statements[LENGTH_TRACE_IOCTL];
+
+	/* Sanity check.  */
+	if (syscall > UINT32_MAX)
+		return -ERANGE;
+
+	ioctl_filter_statements(statements, syscall, flag);
+
+	DEBUG_FILTER("FILTER:     trace if syscall == %ld and its command is handled\n", syscall);
+
+	return add_statements(program, LENGTH_TRACE_IOCTL, statements);
+}
