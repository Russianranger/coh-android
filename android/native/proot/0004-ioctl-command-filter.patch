 	const size_t syscall_offset = offsetof(struct seccomp_data, nr);
 	const size_t section_length = LENGTH_END_SECTION +
-					nb_traced_syscalls * LENGTH_TRACE_SYSCALL;
+					nb_traced_syscalls * LENGTH_TRACE_SYSCALL +
+					nb_extra_statements;
