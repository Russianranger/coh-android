<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.russianranger.cohclientinteractive"
    android:versionCode="4" android:versionName="0.9.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="COH Character Creation" android:icon="@drawable/ic_coh_client"
        android:theme="@style/PresentationTheme" android:allowBackup="false" android:extractNativeLibs="true"
        android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name="io.github.russianranger.cohclientinteractive.ClientActivity" android:exported="true" android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="io.github.russianranger.cohclientinteractive.ClientService" android:exported="false"
            android:foregroundServiceType="dataSync">
        </service>
    </application>
</manifest>
