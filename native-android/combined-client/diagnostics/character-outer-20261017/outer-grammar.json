  "scope": "Exact original wire ordering/schema ledger. Only helper/group4 receipts establish execution; unexecuted helpers remain explicit dependencies. No native full-tail or actor admission.",
  "group4": [
    {
      "field": "tray.current_trays",
      "count": 4,
      "wire": "U32 each"
    },
    {
      "field": "tray.trayIndexes",
      "wire": "U32"
    },
    {
      "field": "tray.slots",
      "builds": 8,
      "trays_per_build": 9,
      "slots_per_tray": 10,
      "count": 720,
      "wire": "type5; power(type1):U32 set,U32 power; inspiration(type2):Pack3 column,Pack3 row; macro(type6/17):string command[256],short[32],icon[256]; other types:no body",
      "ordering": "build first,then flat tray/slot; null emits type0"
    },
    {
      "field": "default_power",
      "wire": "presence1; if present U32set,U32power"
    },
    {
      "field": "tray_mode",
      "wire": "mode1,mode_alt2:1"
    },
    {
      "field": "entity.name",
      "wire": "string",
      "original_consumer_copy_bytes": 32
    },
    {
      "field": "entity.strings",
      "wire": "motto string then description string",
      "source_array_bytes": [
        128,
        1024
      ],
      "consumer_side_effect": "receiveEntStrings changes description angle brackets to square; raw native staging must preserve wire"
    },
    {
      "field": "popHelpStatus",
      "count": 128,
      "wire": "U32 each"
    },
    {
      "field": "popHelpLatest",
      "count": 5,
      "wire": "U32 each"
    },
    {
      "field": "windows",
      "count": 128,
      "wire": "Pack1idx,xp,yp,mode,locked,color,backcolor; maximized1; dimensions_present1 then Pack1wd,Pack1ht; scale_present1 then F32",
      "source_semantics": "ALWAYS_CLOSED(2) forces WINDOW_DOCKED(4); draggable_frame or idx4 sends dimensions; absent/zero scale maps1.f in original consumer"
    }
  ],
  "group5": [
    {
      "field": "rewardTokens",
      "wire": "Auto count; reverse source array order each string name,Pack1value,Pack1timer"
    },
    {
      "field": "activePlayerRewardTokens",
      "wire": "Auto count; reverse source array order each string name,Pack1value,Pack1timer"
    },
    {
      "field": "lfg,hidden",
      "wire": "10bits each"
    },
    {
      "field": "supergroup_mode,hide_supergroup_emblem,skillsUnlocked,teambuff_display",
      "wire": "1bit each"
    },
    {
      "field": "dock_mode,inspiration_mode,newFeaturesVersion",
      "wire": "32bits each"
    }
  ],
  "group6": [
    {
      "field": "chatSettings",
      "wire": "SERVER help-added-now1; Pack1chatSendChannel,userSendChannel,options,primaryChatMinimized;5windows each Pack1selectedtop,selectedbot,tabListBF,F32divider;20tabs each stringname,64bit array,Pack1userBF,optionsBF,defaultChannel,defaultType;15channels each stringname,Pack1optionsBF,U32color1,U32color2",
      "source_counts": {
        "windows": 5,
        "tabs": 20,
        "channels": 15,
        "system_words": 2
      },
      "status": "schema only; original migration/default/UI wrapper side effects not executed in this fixture"
    },
    {
      "field": "titles",
      "wire": "Pack5titleThe; stringtitleTheText,titleCommon,titleOrigin; Autocolor0,Autocolor1; U32badge; stringtitleSpecial"
    },
    {
      "field": "description,motto,comment",
      "wire": "stringdescription,stringmotto,stringcomment",
      "note": "description/motto repeat prior group4 values; original receiveDescription copies these again without breakHTMLtags"
    },
    {
      "field": "keybinds",
      "wire": "stringprofile;256records each stringcommand,U32key,U32modifier",
      "consumer_semantics": "copy command bound256; key&0xff and key&0xf00 secondary retained separately; development mode substitutes Dev profile",
      "status": "schema only; full original helper remains to execute"
    },
    {
      "field": "options",
      "wire": "saved1; if saved114ordered option fields below; otherwise mouse_invert1,F32mouse_speed,F32turn_speed",
      "status": "original producer/consumer and independent byte model executed"
    },
    {
      "field": "dividers",
      "count": 8,
      "wire": "Pack9 each",
      "ordering": [
        "superName",
        "superMap",
        "superTitle",
        "emailFrom",
        "emailSubject",
        "friendName",
        "lfgName",
        "lfgMap"
      ],
      "application_rule": "original only applies saved dividers when first nonzero"
    },
    {
      "field": "control",
      "wire": "first1,nocoll2"
    },
    {
      "field": "friends",
      "wire": "Pack1full_update,Pack1count; per index present1; if present Pack1dbid,online1,stringname,Pack1class,Pack1origin; online addsPack1mapid,stringmapname",
      "source_semantics": "full character sender always sendsfull_update1; -1 class/origin sentinel is full unsigned packed word; original consumer resolves dictionary indices and prior packet state",
      "status": "schema only; exact original helper remains to execute"
    },
    {
      "field": "combatMonitorStats",
      "count": 10,
      "wire": "IfSetPack8key;IfSet4order",
      "status": "schema only; exact original helper remains to execute"
    },
    {
      "field": "rename",
      "wire": "1bit",
      "boundary": "end of this packet body within sendCharacterToClient; subsequent Contact/Task/Clue/Mission calls send their own separate packets"
    }
  ],
