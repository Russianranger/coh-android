{
  "schema": 1,
  "report": "files/session-report.json",
  "ready": {
    "assets_verified": true,
    "native.frames": {
      "gte": 30
    },
    "native.startup_checked": true,
    "native.gl_errors": 0,
    "native.tf_mismatches": 0,
    "support.configured": true,
    "support.failures": 0,
    "support.hud.frames": {
      "gte": 30
    },
    "support.audio.initialized": 1,
    "support.audio.running": 1,
    "support.audio.last_status": 0,
    "app.version_name": "0.2.0-gameplay",
    "app.version_code": 201,
    "support.ui_extensions.authentic_tray_images": 11,
    "support.audio_environment.listener_updates": {
      "gt": 0
    },
    "support.observations.counters.draw_calls.known": true,
    "support.observations.counters.draw_calls.owner_total": {
      "gt": 0
    },
    "support.observations.counters.upload_bytes.known": true,
    "support.observations.counters.allocations.known": false,
    "support.observations.memory.process_rss.known": false,
    "support.performance.invalid_samples": 0,
    "process_memory.rss_measured": true,
    "process_memory.native.rss.bytes": {
      "gt": 0
    },
    "process_memory.sample_age_ms": {
      "lte": 5000
    },
    "process_memory.sample_duration_ms": {
      "gte": 0
    }
  },
  "fatal_fields": [
    "native.failed",
    "support.failures",
    "support.hud.gl_errors",
    "support.audio.device_error",
    "native.appearance_preview.failures"
  ],
  "steps": [
    {
      "label": "Authentic neutral punch mock",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Mock animation"
        }
      ],
      "assert": {
        "support.animation.samples": {
          "gt": 5
        },
        "support.animation.triggers": 1,
        "support.animation.kind": 0
      },
      "screenshot": true
    },
    {
      "label": "Authentic jump-power mock without jump physics",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Mock animation"
        }
      ],
      "assert": {
        "support.animation.triggers": 2,
        "support.animation.kind": 1,
        "support.animation.samples": {
          "increases": true
        }
      },
      "screenshot": false
    },
    {
      "label": "Authentic reaction mock",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Mock animation"
        }
      ],
      "assert": {
        "support.animation.triggers": 3,
        "support.animation.kind": 2,
        "support.animation.samples": {
          "increases": true
        }
      },
      "screenshot": false
    },
    {
      "label": "Restore accepted grounded locomotion",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Mock animation"
        }
      ],
      "assert": {
        "support.animation.triggers": 4,
        "support.animation.kind": 3,
        "native.frames": {
          "increases": true
        }
      },
      "screenshot": false
    },
    {
      "label": "Touch native power tray",
      "actions": [
        {
          "kind": "hud_tap",
          "x": 265,
          "y": 716
        }
      ],
      "assert": {
        "support.hud.power_uses": {
          "increases": true
        }
      },
      "screenshot": false
    },
    {
      "label": "Captured HUD drag does not steer scene camera",
      "actions": [
        {
          "kind": "hud_swipe",
          "x0": 340,
          "y0": 716,
          "x1": 350,
          "y1": 720,
          "ms": 300
        }
      ],
      "assert": {
        "support.hud.power_uses": {
          "increases": true
        },
        "native.camera_yaw": {
          "same": true
        }
      }
    },
    {
      "label": "Touch native character menu and select mock data",
      "actions": [
        {
          "kind": "hud_tap",
          "x": 100,
          "y": 700
        },
        {
          "kind": "wait",
          "seconds": 1
        },
        {
          "kind": "hud_tap",
          "x": 500,
          "y": 188
        }
      ],
      "assert": {
        "support.hud.character_selections": {
          "increases": true
        }
      },
      "screenshot": true
    },
    {
      "label": "Android keyboard commit to native chat",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Chat text"
        },
        {
          "kind": "text",
          "text": "Offline native chat"
        },
        {
          "kind": "tap_text",
          "text": "Send"
        }
      ],
      "assert": {
        "support.hud.chat_submits": {
          "increases": true
        }
      },
      "screenshot": false
    },
    {
      "label": "Controller navigation and native power intent",
      "actions": [
        {
          "kind": "tap_text",
          "text": "UI navigation: OFF"
        },
        {
          "kind": "key",
          "source": "gamepad",
          "key": "KEYCODE_BUTTON_R1"
        },
        {
          "kind": "key",
          "source": "gamepad",
          "key": "KEYCODE_BUTTON_A"
        }
      ],
      "assert": {
        "support.hud.power_uses": {
          "increases": true
        }
      },
      "screenshot": false
    },
    {
      "label": "Pause and joined native audio diagnostics",
      "actions": [
        {
          "kind": "home"
        }
      ],
      "assert": {
        "support.audio.running": 0,
        "support.audio.diagnostics_valid": 1,
        "support.audio.callback_calls": {
          "gt": 0
        },
        "support.audio.rendered_frames": {
          "gt": 0
        },
        "support.audio.last_status": 0
      },
      "screenshot": true
    },
    {
      "label": "Home recovery with resumed native audio",
      "actions": [
        {
          "kind": "launch"
        }
      ],
      "assert": {
        "native.frames": {
          "increases": true
        },
        "support.audio.running": 1,
        "support.audio.opens": {
          "increases": true
        },
        "support.hud.chat_submits": {
          "same": true
        }
      },
      "screenshot": false
    },
    {
      "label": "Surface recreation retains HUD and native state",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Recreate"
        }
      ],
      "assert": {
        "native.contexts_started": {
          "increases": true
        },
        "support.hud.surface_recreates": {
          "increases": true
        },
        "support.hud.chat_submits": {
          "same": true
        },
        "native.frames": {
          "increases": true
        }
      },
      "screenshot": true
    },
    {
      "label": "Bounded Near Far selection",
      "actions": [
        {
          "kind": "tap_text",
          "text": "View distance"
        }
      ],
      "assert": {
        "native.stream.view_radius": 96,
        "native.frames": {
          "increases": true
        }
      },
      "screenshot": false
    },
    {
      "label": "Landscape compact viewport preserves visible native scene",
      "actions": [
        {
          "kind": "rotate",
          "rotation": 1
        }
      ],
      "assert": {
        "input_area.controls_expanded": false,
        "input_area.scene_fraction": {
          "gte": 0.65
        },
        "input_area.width": {
          "gt": 1000
        },
        "input_area.height": {
          "gt": 400
        },
        "native.frames": {
          "increases": true
        }
      },
      "screenshot": true
    },
    {
      "label": "Open native character details presentation",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Panels"
        }
      ],
      "assert": {
        "support.presentation.visible": true,
        "support.presentation.tab": 0,
        "support.presentation.builds": {
          "increases": true
        }
      },
      "screenshot": true
    },
    {
      "label": "Inventory panel and typed touch inspection",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Panels"
        },
        {
          "kind": "wait",
          "seconds": 1
        },
        {
          "kind": "hud_tap",
          "x": 700,
          "y": 230
        }
      ],
      "assert": {
        "support.presentation.tab": 1,
        "support.presentation.intents": {
          "increases": true
        },
        "native.camera_yaw": {
          "same": true
        }
      },
      "screenshot": true
    },
    {
      "label": "Enhancement mission and contact panels",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Panels"
        },
        {
          "kind": "tap_text",
          "text": "Panels"
        },
        {
          "kind": "tap_text",
          "text": "Panels"
        }
      ],
      "assert": {
        "support.presentation.tab": 4,
        "support.presentation.visible": true
      },
      "screenshot": true
    },
    {
      "label": "Controller closes presentation without scene input",
      "actions": [
        {
          "kind": "key",
          "source": "gamepad",
          "key": "KEYCODE_BUTTON_B"
        }
      ],
      "assert": {
        "support.presentation.visible": false,
        "support.presentation.intents": {
          "increases": true
        },
        "native.camera_yaw": {
          "same": true
        }
      }
    },
    {
      "label": "Local damage presentation and copied event cues",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Mock hit"
        }
      ],
      "assert": {
        "support.presentation.events": {
          "increases": true
        },
        "support.presentation.cues": {
          "increases": true
        },
        "support.presentation.target_health": {
          "changes": true
        },
        "support.presentation.offline_only": true,
        "support.presentation.animation_bindings": {
          "increases": true
        },
        "support.presentation.audio_binding_available": false
      },
      "screenshot": true
    },
    {
      "label": "Landscape Home resume retains mock presentation state",
      "actions": [
        {
          "kind": "home"
        },
        {
          "kind": "wait",
          "seconds": 1
        },
        {
          "kind": "launch"
        }
      ],
      "assert": {
        "support.audio.running": 1,
        "support.presentation.events": {
          "same": true
        },
        "input_area.controls_expanded": false,
        "input_area.scene_fraction": {
          "gte": 0.65
        },
        "native.frames": {
          "increases": true
        }
      },
      "screenshot": true
    },
    {
      "label": "Complete authentic Male neutral costume preview",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Preview: Wretch"
        }
      ],
      "assert": {
        "native.appearance_preview.available": true,
        "native.appearance_preview.active": true,
        "native.appearance_preview.parts": 8,
        "native.appearance_preview.frames": {
          "gt": 15
        },
        "native.appearance_preview.draws": {
          "gt": 100
        },
        "native.appearance_preview.failures": 0,
        "native.frames": {
          "increases": true
        }
      },
      "screenshot": true
    },
    {
      "label": "Male preview survives background and Surface recovery",
      "actions": [
        {
          "kind": "home"
        },
        {
          "kind": "wait",
          "seconds": 1
        },
        {
          "kind": "launch"
        }
      ],
      "assert": {
        "native.appearance_preview.active": true,
        "native.appearance_preview.frames": {
          "increases": true
        },
        "native.appearance_preview.surface_uploads": {
          "increases": true
        },
        "native.appearance_preview.failures": 0,
        "native.contexts_started": {
          "increases": true
        },
        "support.audio.running": 1
      },
      "screenshot": true
    },
    {
      "label": "Return to accepted Wretch scene after Male preview",
      "actions": [
        {
          "kind": "tap_text",
          "text": "Preview: Male"
        }
      ],
      "assert": {
        "native.appearance_preview.active": false,
        "native.actor_draws": {
          "increases": true
        },
        "native.gl_errors": 0,
        "native.frames": {
          "increases": true
        }
      },
      "screenshot": true
    }
  ]
}
