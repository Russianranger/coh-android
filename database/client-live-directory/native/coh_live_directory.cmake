# Dormant Game-only native source candidate. Runtime enablement is separate.
if(NOT PROJECT_IS_TOP_LEVEL)
    return()
endif()
function(coh_live_directory_define)
    if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 4)
        message(FATAL_ERROR "Live directory consumer requires MSVC Win32")
    endif()
    if(NOT TARGET UtilitiesLib OR NOT TARGET Game)
        message(FATAL_ERROR "Live directory consumer requires retained Game/UtilitiesLib")
    endif()
    if(COX_BUILD_MAPSERVER OR COX_BUILD_BEACONSERVER)
        message(FATAL_ERROR "Live directory candidate is Game-only")
    endif()
    target_compile_definitions(UtilitiesLib PRIVATE COH_CLIENT_LIVE_DIRECTORY=1)
    target_compile_definitions(Game PRIVATE COH_CLIENT_LIVE_DIRECTORY=1)
    target_sources(UtilitiesLib PRIVATE "${CMAKE_SOURCE_DIR}/libs/UtilitiesLib/src/utils/coh_live_transport.c")
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL coh_live_directory_define)
