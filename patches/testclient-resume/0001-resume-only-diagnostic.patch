+// Opt-in diagnostic mode. Validate before the legacy parser dereferences argv.
+// Keep the requested name independent of mutable character_name during a session.
+static void validateResumeOnlyArgs(int argc, char **argv) {
+    int i, names = 0;
+    const char *name = NULL;
+    for (i = 1; i < argc; i++) {
+        if (stricmp(argv[i], "-resumeonly") == 0)
+            resume_only = 1;
+    }
+    if (!resume_only)
+        return;
+    for (i = 1; i < argc; i++) {
+        if (stricmp(argv[i], "-character") == 0) {
+            names++;
+            if (i + 1 < argc)
+                name = argv[i + 1];
+        }
+    }
+    if (names != 1 || !name || !name[0] || name[0] == '-' ||
+        strlen(name) >= sizeof(resume_only_name) || stricmp(name, "empty") == 0) {
+        printf("COH_RESUME_ONLY_INVALID_ARGUMENTS requires_one_character_name\n");
+        exit(2);
+    }
+    for (i = 0; name[i]; i++) {
+        if ((unsigned char)name[i] < 32 || (unsigned char)name[i] == 127) {
+            printf("COH_RESUME_ONLY_INVALID_ARGUMENTS character_name_control_byte\n");
+            exit(2);
+        }
+    }
+    strcpy(resume_only_name, name);
+}
+
+static void finalizeResumeOnlyMode(void) {
+    if (!resume_only)
+        return;
+    if (ask_user) {
+        printf("COH_RESUME_ONLY_INVALID_ARGUMENTS askuser_not_supported\n");
+        exit(2);
+    }
+    // Finalize after every mode argument, including -justlogin and -disconnect.
+    g_testMode = TEST_LOGIN | TEST_RESUME_CHAR | TEST_STAY_CONNECTED;
+    g_testMode2 = 0;
+    g_testModeMission = 0;
+    g_testModeAccount = 0;
+}
+
+static int reportResumeOnlySelection(void) {
+    if (!resume_only)
+        return 0;
+    if (!db_info.players || gPlayerNumber < 0 || gPlayerNumber >= db_info.max_slots) {
+        printf("COH_RESUME_ONLY_MISSING name=%s\n", resume_only_name);
+        return 3;
+    }
+    if (strcmp(db_info.players[gPlayerNumber].name, resume_only_name) != 0) {
+        printf("COH_RESUME_ONLY_INVALID_SELECTION name=%s\n", resume_only_name);
+        return 4;
+    }
+    resume_only_update_seen = 0;
+    // This protocol supplies slot/name here, not the character database ID.
+    printf("COH_RESUME_ONLY_SELECTED slot=%d name=%s\n",
+        gPlayerNumber, db_info.players[gPlayerNumber].name);
+    return 0;
+}
+
+static void reportResumeOnlyServerUpdate(void) {
+    Entity *e = playerPtr();
+    if (!e || e->db_id <= 0 ||
+        strcmp(e->name, resume_only_name) != 0) {
+        printf("COH_RESUME_ONLY_IDENTITY_MISMATCH\n");
+        statusUpdate("ERROR");
+        exit(4);
+    }
+    // e->db_id was received in the MapServer player entity packet. The
+    // independent harness binds it to the original SQL/find character ID.
+    printf("COH_RESUME_ONLY_SERVER_UPDATE id=%d name=%s\n", e->db_id, e->name);
+    resume_only_update_seen = 1;
+}
