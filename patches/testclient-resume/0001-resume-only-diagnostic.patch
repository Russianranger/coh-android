+// Opt-in diagnostic mode. Validate before the legacy parser dereferences argv.
+// Keep the requested name independent of mutable character_name during a session.
+static void validateResumeOnlyArgs(int argc, char **argv) {
+    int i, names = 0;
+    const char *name = NULL;
+    for (i = 1; i < argc; i++) {
+        if (stricmp(argv[i], "-resumeonly") == 0)
+            resume_only = 1;
+    }
+    if (!resume_only)
+        return;
+    for (i = 1; i < argc; i++) {
+        if (stricmp(argv[i], "-character") == 0) {
+            names++;
+            if (i + 1 < argc)
+                name = argv[i + 1];
+        }
+    }
+    if (names != 1 || !name || !name[0] || name[0] == '-' ||
+        strlen(name) >= sizeof(resume_only_name) || stricmp(name, "empty") == 0) {
+        printf("COH_RESUME_ONLY_INVALID_ARGUMENTS requires_one_character_name\n");
+        exit(2);
+    }
+    for (i = 0; name[i]; i++) {
+        if ((unsigned char)name[i] < 32 || (unsigned char)name[i] == 127) {
+            printf("COH_RESUME_ONLY_INVALID_ARGUMENTS character_name_control_byte\n");
+            exit(2);
+        }
+    }
+    strcpy(resume_only_name, name);
+}
+
+static void finalizeResumeOnlyMode(void) {
+    if (!resume_only)
+        return;
+    if (ask_user) {
+        printf("COH_RESUME_ONLY_INVALID_ARGUMENTS askuser_not_supported\n");
+        exit(2);
+    }
+    // Finalize after every mode argument, including -justlogin and -disconnect.
+    g_testMode = TEST_LOGIN | TEST_RESUME_CHAR | TEST_STAY_CONNECTED;
+    g_testMode2 = 0;
+    g_testModeMission = 0;
+    g_testModeAccount = 0;
+}
+
+static int reportResumeOnlySelection(void) {
+    if (!resume_only)
+        return 0;
+    if (!db_info.players || gPlayerNumber < 0 || gPlayerNumber >= db_info.max_slots) {
+        printf("COH_RESUME_ONLY_MISSING name=%s\n", resume_only_name);
+        return 3;
+    }
+    if (strcmp(db_info.players[gPlayerNumber].name, resume_only_name) != 0) {
+        printf("COH_RESUME_ONLY_INVALID_SELECTION name=%s\n", resume_only_name);
+        return 4;
+    }
+    resume_only_update_seen = 0;
+    resume_only_player_id = 0;
+    resume_only_transfer_epoch = 0;
+    // This protocol supplies slot/name here, not the character database ID.
+    printf("COH_RESUME_ONLY_SELECTED slot=%d name=%s\n",
+        gPlayerNumber, db_info.players[gPlayerNumber].name);
+    return 0;
+}
+
+static void resumeOnlyProofError(const char *reason) {
+    printf("COH_RESUME_ONLY_TRANSFER_PROOF_ERROR reason=%s\n", reason);
+    statusUpdate("ERROR");
+    exit(4);
+}
+
+static void armResumeOnlyTransferProof(void) {
+    if (!resume_only)
+        return;
+    // Arm only after doMapXfer succeeded. A prior unacknowledged epoch cannot
+    // be silently skipped by another transfer or reused as destination proof.
+    if (resume_only_player_id <= 0 || !resume_only_update_seen || do_map_xfer ||
+        !commConnected() || resume_only_transfer_epoch == INT_MAX)
+        resumeOnlyProofError("invalid_transfer_boundary");
+    resume_only_peer_ip = comm_link.addr.sin_addr.s_addr;
+    resume_only_peer_port = ntohs(comm_link.addr.sin_port);
+    resume_only_base_map = game_state.base_map_id;
+    resume_only_instance = game_state.map_instance_id;
+    if (!resume_only_peer_ip || resume_only_peer_port <= 0 ||
+        resume_only_base_map <= 0 || resume_only_instance < 0 ||
+        resume_only_peer_ip != db_info.mapserver.ip ||
+        resume_only_peer_port != db_info.mapserver.port)
+        resumeOnlyProofError("invalid_destination_endpoint");
+    resume_only_transfer_epoch++;
+    resume_only_update_seen = 0;
+}
+
+static void reportResumeOnlyServerUpdate(void) {
+    Entity *e;
+    // A scan can process UPDATE and MAP_XFER together. Never label the old
+    // link's update with destination metadata already supplied by MAP_XFER.
+    if (!resume_only || resume_only_update_seen || do_map_xfer || !commConnected())
+        return;
+    e = playerPtr();
+    if (!e || e->db_id <= 0 ||
+        strcmp(e->name, resume_only_name) != 0 ||
+        (resume_only_player_id && e->db_id != resume_only_player_id)) {
+        printf("COH_RESUME_ONLY_IDENTITY_MISMATCH\n");
+        statusUpdate("ERROR");
+        exit(4);
+    }
+    if (resume_only_transfer_epoch == 0) {
+        // e->db_id was received in the MapServer player entity packet. The
+        // independent harness binds it to the original SQL/find character ID.
+        resume_only_player_id = e->db_id;
+        printf("COH_RESUME_ONLY_SERVER_UPDATE id=%d name=%s\n", e->db_id, e->name);
+    } else {
+        if (comm_link.addr.sin_addr.s_addr != resume_only_peer_ip ||
+            ntohs(comm_link.addr.sin_port) != resume_only_peer_port ||
+            game_state.base_map_id != resume_only_base_map ||
+            game_state.map_instance_id != resume_only_instance)
+            resumeOnlyProofError("destination_changed_before_update");
+        printf("COH_RESUME_ONLY_TRANSFER_UPDATE epoch=%d id=%d base_map=%d instance=%d ip=%s port=%d name=%s\n",
+            resume_only_transfer_epoch, e->db_id, resume_only_base_map, resume_only_instance,
+            makeIpStr(resume_only_peer_ip), resume_only_peer_port, e->name);
+    }
+    resume_only_update_seen = 1;
+}
