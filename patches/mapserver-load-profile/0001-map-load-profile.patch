diff --git a/Common/group/armport_map_load_profile.h b/Common/group/armport_map_load_profile.h
new file mode 100644
index 0000000..304b20f
--- /dev/null
+++ b/Common/group/armport_map_load_profile.h
@@ -0,0 +1,122 @@
+/* ArmPort opt-in (ARMPORT_SERVER_METRICS=1, read at the first map load): where the wall
+ * time of "loading map" goes. Exclusive time per step on the loading thread, one record
+ * after the load. Measurement only: nothing in the game reads it. Server only.
+ */
+#ifndef ARMPORT_MAP_LOAD_PROFILE_H
+#define ARMPORT_MAP_LOAD_PROFILE_H
+
+enum
+{
+    ARMPORT_MAP_LOAD_OTHER,
+    ARMPORT_MAP_LOAD_MODEL_FIND,
+    ARMPORT_MAP_LOAD_REF_ACTIVATE,
+    ARMPORT_MAP_LOAD_RECALC_BOUNDS,
+    ARMPORT_MAP_LOAD_BOUNDS_FILES,
+    ARMPORT_MAP_LOAD_SCENE,
+    ARMPORT_MAP_LOAD_SPAWN_AREAS,
+    ARMPORT_MAP_LOAD_STEPS
+};
+
+#ifdef SERVER
+void armportMapLoadBegin(void);
+void armportMapLoadEnter(int step);
+void armportMapLoadLeave(void);
+void armportMapLoadReport(void);
+#else
+#define armportMapLoadEnter(step) ((void)0)
+#define armportMapLoadLeave() ((void)0)
+#endif
+
+#ifdef ARMPORT_MAP_LOAD_PROFILE_IMPLEMENTATION
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <utilitieslib/utils/timing.h>
+
+#define ARMPORT_MAP_LOAD_DEPTH 32
+
+static struct
+{
+    int enabled, active, depth;
+    int stack[ARMPORT_MAP_LOAD_DEPTH];
+    S64 begin, last;
+    S64 ticks[ARMPORT_MAP_LOAD_STEPS];
+    unsigned int calls[ARMPORT_MAP_LOAD_STEPS];
+} armport_map_load = { -1 };
+
+/* The time since the last change belongs to the step on top of the stack. */
+static void armportMapLoadCharge(void)
+{
+    S64 now = timerCpuTicks64();
+    int top = armport_map_load.depth < ARMPORT_MAP_LOAD_DEPTH ? armport_map_load.depth : ARMPORT_MAP_LOAD_DEPTH - 1;
+    armport_map_load.ticks[armport_map_load.stack[top]] += now - armport_map_load.last;
+    armport_map_load.last = now;
+}
+
+void armportMapLoadBegin(void)
+{
+    if (armport_map_load.enabled < 0)
+    {
+        const char* value = getenv("ARMPORT_SERVER_METRICS");
+        armport_map_load.enabled = value && value[0] == '1' && value[1] == '\0';
+    }
+    if (!armport_map_load.enabled)
+        return;
+    memset(armport_map_load.ticks, 0, sizeof(armport_map_load.ticks));
+    memset(armport_map_load.calls, 0, sizeof(armport_map_load.calls));
+    armport_map_load.depth = 0;
+    armport_map_load.stack[0] = ARMPORT_MAP_LOAD_OTHER;
+    armport_map_load.begin = armport_map_load.last = timerCpuTicks64();
+    armport_map_load.active = 1;
+}
+
+void armportMapLoadEnter(int step)
+{
+    if (!armport_map_load.active)
+        return;
+    armportMapLoadCharge();
+    ++armport_map_load.depth;
+    if (armport_map_load.depth < ARMPORT_MAP_LOAD_DEPTH)
+        armport_map_load.stack[armport_map_load.depth] = step;
+    ++armport_map_load.calls[step];
+}
+
+void armportMapLoadLeave(void)
+{
+    if (!armport_map_load.active || armport_map_load.depth <= 0)
+        return;
+    armportMapLoadCharge();
+    --armport_map_load.depth;
+}
+
+#define ARMPORT_MAP_LOAD_MS(step) ((int)(armport_map_load.ticks[step] * 1000 / speed))
+
+void armportMapLoadReport(void)
+{
+    S64 speed;
+
+    if (!armport_map_load.active)
+        return;
+    armportMapLoadCharge();
+    armport_map_load.active = 0;
+    speed = timerCpuSpeed64();
+    if (speed <= 0)
+    {
+        printf("ARMPORT_MAP_LOAD_V1 status=clock_error\n");
+        return;
+    }
+    printf("ARMPORT_MAP_LOAD_V1 status=ok total_ms=%d other_ms=%d model_find_ms=%d model_finds=%u "
+           "ref_activate_ms=%d ref_activates=%u recalc_bounds_ms=%d bounds_files_ms=%d bounds_files=%u "
+           "scene_ms=%d spawn_areas_ms=%d unbalanced=%d\n",
+           (int)((armport_map_load.last - armport_map_load.begin) * 1000 / speed),
+           ARMPORT_MAP_LOAD_MS(ARMPORT_MAP_LOAD_OTHER),
+           ARMPORT_MAP_LOAD_MS(ARMPORT_MAP_LOAD_MODEL_FIND), armport_map_load.calls[ARMPORT_MAP_LOAD_MODEL_FIND],
+           ARMPORT_MAP_LOAD_MS(ARMPORT_MAP_LOAD_REF_ACTIVATE), armport_map_load.calls[ARMPORT_MAP_LOAD_REF_ACTIVATE],
+           ARMPORT_MAP_LOAD_MS(ARMPORT_MAP_LOAD_RECALC_BOUNDS),
+           ARMPORT_MAP_LOAD_MS(ARMPORT_MAP_LOAD_BOUNDS_FILES), armport_map_load.calls[ARMPORT_MAP_LOAD_BOUNDS_FILES],
+           ARMPORT_MAP_LOAD_MS(ARMPORT_MAP_LOAD_SCENE), ARMPORT_MAP_LOAD_MS(ARMPORT_MAP_LOAD_SPAWN_AREAS),
+           armport_map_load.depth);
+}
+#endif
+
+#endif
