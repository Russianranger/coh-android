+static INLINEDBG void wtQueueCounter(U64 *counter)
+{
+    if (*counter != ~(U64)0) ++*counter;
+}
+
+static int wtQueueWall(WorkerThread *wt, double *value)
+{
+    LARGE_INTEGER ticks;
+    if (wt->queue_clock_frequency <= 0.0 || !QueryPerformanceCounter(&ticks) || ticks.QuadPart < 0)
+        return 0;
+    *value = (double)ticks.QuadPart * 1000.0 / wt->queue_clock_frequency;
+    return *value >= 0.0 && *value < 1.0e12;
+}
+
+/* Must be selected by the render-instance owner before the worker starts.
+ * Other workers retain the accepted handshake and notification behavior. */
+void wtEnableWakeCoalescing(WorkerThread *wt, int diagnostics_enabled)
+{
+    LARGE_INTEGER frequency;
+    assert(wt && !wt->thread_handle && wt->thread_state == THREAD_NOTSTARTED);
+    wt->wake_coalescing = 1;
+    wt->queue_diagnostics = !!diagnostics_enabled;
+    if (wt->queue_diagnostics && QueryPerformanceFrequency(&frequency) && frequency.QuadPart > 0)
+        wt->queue_clock_frequency = (double)frequency.QuadPart;
+}
+
+void wtGetRenderQueueStats(WorkerThread *wt, WTRenderQueueStats *snapshot)
+{
+    assert(wt && snapshot);
+    *snapshot = wt->queue_stats;
+}
