+// Optional render-instance first-wake acknowledgement and producer diagnostics.
+// Counters are copied only by the command-producing thread, never by the worker.
+typedef struct WTRenderQueueStats
+{
+    U64 commands, armed_observations, wake_signals, wake_signal_failures, pending_commands;
+    U64 ring_waits, ring_wait_iterations, ring_wait_clock_failures;
+    double ring_wait_wall_ms, ring_wait_max_ms;
+} WTRenderQueueStats;
+void wtEnableWakeCoalescing(WorkerThread *wt, int diagnostics_enabled);
+void wtGetRenderQueueStats(WorkerThread *wt, WTRenderQueueStats *snapshot);
 
 // set threading and start worker thread
 void wtStart(WorkerThread *wt);
