+static void beaconHostVerifyCurrentAtlasGraph(void){
+    S32 i, connected = 0, ground = 0, raised = 0, paths = 0;
+    char freshMapName[] = "maps/city_zones/city_01_01/city_01_01.txt";
+    NavSearch* search;
+    groupLoadMap(freshMapName, 0, 0);
+    assert(beaconDoesTheBeaconFileMatchTheMap(1));
+    beaconReload();
+    assert(beaconGetReadFileVersion() == 8);
+    assert(combatBeaconArray.size > 1000 && combatBeaconArray.size <= 1000000);
+    assert(combatBeaconGridBlockArray.size > 0);
+    for(i = 0; i < combatBeaconArray.size; i++){
+        Beacon* b = combatBeaconArray.storage[i];
+        connected += b->gbConns.size || b->rbConns.size;
+        ground += b->gbConns.size;
+        raised += b->rbConns.size;
+    }
+    assert(connected > 1000 && ground > 1000);
+    beaconSetPathFindEntity(NULL, 0);
+    search = createNavSearch();
+    for(i = 0; i < combatBeaconArray.size && paths < 32; i += max(1, combatBeaconArray.size / 1000)){
+        Beacon* src = combatBeaconArray.storage[i];
+        Beacon* dst = src;
+        NavSearchResults result = {0};
+        S32 j;
+        for(j = 0; j < 12 && dst->gbConns.size; j++){
+            BeaconConnection* c = dst->gbConns.storage[(i + j) % dst->gbConns.size];
+            dst = c->destBeacon;
+        }
+        if(distance3(posPoint(src), posPoint(dst)) < 20) continue;
+        clearNavSearch(search);
+        beaconPathFind(search, posPoint(src), posPoint(dst), &result);
+        if(result.resultType == NAV_RESULT_SUCCESS && search->path.waypointCount >= 2) paths++;
+    }
+    destroyNavSearch(search);
+    assert(paths == 32);
+    printf("COH_ATLAS_BEACON_NATIVE_V1 crc=0x%08x combat=%d connected=%d ground=%d raised=%d blocks=%d paths=%d\n",
+           beaconGetMapCRC(0, 1, 0), combatBeaconArray.size, connected,
+           ground, raised, combatBeaconGridBlockArray.size, paths);
+    fflush(fileGetStdout());
 }
 
