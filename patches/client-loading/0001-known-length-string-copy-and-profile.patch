+// The flags are thread local because string allocations also occur outside the
+// serial BIN loader. No shared scratch buffer or additional allocation is used.
+static __declspec(thread) int coh_client_loading_flags = -1;
+static __declspec(thread) unsigned int coh_client_known_length_copies;
+static int cohClientLoadingFlags(void)
+{
+    if (coh_client_loading_flags < 0)
+    {
+        const char *copy = getenv("COH_CLIENT_KNOWN_STRING_COPY");
+        const char *profile = getenv("COH_CLIENT_BIN_PROFILE");
+        coh_client_loading_flags = (copy && strcmp(copy, "1") == 0 ? 1 : 0)
+            | (profile && strcmp(profile, "1") == 0 ? 2 : 0);
+    }
+    return coh_client_loading_flags;
+}
+
+static void cohClientBinProfile(const char *phase, const char *filename,
+    DWORD begin, int success, unsigned int copies)
+{
+    printf("COH_CLIENT_BIN_PROFILE_V1 phase=%s path=%s milliseconds=%.3f success=%d known_length_copies=%u crc_validation_preserved=1 source_freshness_preserved=1\n",
+        phase, filename ? filename : "<memory>",
+        (double)(DWORD)(GetTickCount() - begin), success, copies);
+}
