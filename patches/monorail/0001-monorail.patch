+/* Finite opt-in Android station queue. Stock door validation and animation
+ * run again after the owned destination has completed live native ticks. */
+static EntityRef cohMonorailEntity;
+static Vec3 cohMonorailDoorPosition;
+static char cohMonorailSelection[80];
+static int cohMonorailResuming;
+
+void cohMonorailDoorTick(void)
+{
+    Entity *e;
+    int result;
+    if (!cohMonorailEntity) return;
+    e = erGetEnt(cohMonorailEntity);
+    if (!e || !e->ready || e->dbcomm_state.map_xfer_step ||
+        distance3Squared(ENTPOS(e), cohMonorailDoorPosition) > 2500.0f) {
+        cohMonorailCancel(); cohMonorailEntity = 0; return;
+    }
+    result = cohMonorailPoll(db_state.map_id, e->db_id, e->auth_id);
+    if (!result) return;
+    cohMonorailEntity = 0;
+    if (result < 0) { sendInfoBox(e, INFO_SVR_COM, "Station preparation timed out; export the report."); return; }
+    cohMonorailResuming = 1;
+    enterDoor(e, cohMonorailDoorPosition, cohMonorailSelection, 0, NULL);
+    cohMonorailResuming = 0;
+}
