+// ArmPort single-player (0.13.85). Two switches read once from the environment of the game
+// client and of the map server; unset, every function below answers as before.
+//   ARMPORT_UNLOCK_ALL=1  the one local account owns every store product and every loyalty
+//                         (veteran) reward and is a VIP. Counts of consumable products
+//                         (AccountGetStoreProductCount) are not changed.
+//   ARMPORT_PRIMALIST=1   the Primalist archetype's product ("ctatprim") is owned. It is not
+//                         part of ARMPORT_UNLOCK_ALL: the archetype also needs its class data
+//                         on the map server and its name in the database.
+static int armport_switch(const char *name, int *state)
+{
+    if (*state < 0)
+    {
+        const char *value = getenv(name);
+        *state = (value && value[0] == '1' && value[1] == 0) ? 1 : 0;
+    }
+    return *state;
+}
+
+int armport_unlock_all(void)
+{
+    static int state = -1;
+    return armport_switch("ARMPORT_UNLOCK_ALL", &state);
+}
+
+int armport_primalist(void)
+{
+    static int state = -1;
+    return armport_switch("ARMPORT_PRIMALIST", &state);
+}
