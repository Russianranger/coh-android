+/* States: 0=default/unbound, 1=loopback/unbound, 2=default/binding,
+ * 3=loopback/binding. CAS makes activation and the first bind mutually ordered.
+ * This library hook has no effect until an explicit startup request enables it. */
+static volatile LONG sock_bind_policy = 0;
+
+int sockSetLoopbackOnlyMode(void)
+{
+    return InterlockedCompareExchange(&sock_bind_policy, 1, 0) == 0;
+}
+
+static void sockLoopbackFailure(SOCKET sock, const char *reason, int error)
+{
+    /* Some stock callers ignore sockBind failure. Never let an opted-in
+     * diagnostic continue after an unavailable or unverified listener. */
+    closesocket(sock);
+    fprintf(stderr, "COH_WINE_DB_LOOPBACK_ONLY binding failed: %s (Windows socket error %d)\n", reason, error);
+    fflush(stderr);
+    ExitProcess(2);
+}
+
 int    sockBind(SOCKET sock,const struct sockaddr_in *name)
 {
-    if (bind (sock,(struct sockaddr *) name, sizeof(struct sockaddr_in)) >= 0) return 1;
-
-    return 0;
+    LONG policy;
+    struct sockaddr_in local, actual;
+    int length = (int)sizeof(actual);
+    int socket_type, type_length = (int)sizeof(socket_type);
+    unsigned long address;
+
+    do {
+        policy = InterlockedCompareExchange(&sock_bind_policy, 0, 0);
+    } while (InterlockedCompareExchange(&sock_bind_policy, policy | 2, policy) != policy);
+    if (!(policy & 1)) {
+        if (bind (sock,(struct sockaddr *) name, sizeof(struct sockaddr_in)) >= 0) return 1;
+        return 0;
+    }
+    if (!name || name->sin_family != AF_INET)
+        sockLoopbackFailure(sock, "IPv4 address required", WSAEAFNOSUPPORT);
+    local = *name;
+    address = ntohl(local.sin_addr.s_addr);
+    if (address == INADDR_ANY)
+        local.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    else if ((address & 0xff000000UL) != 0x7f000000UL)
+        sockLoopbackFailure(sock, "non-loopback address refused", WSAEADDRNOTAVAIL);
+    if (bind(sock, (struct sockaddr *)&local, sizeof(local)) < 0)
+        sockLoopbackFailure(sock, "bind", WSAGetLastError());
+    memset(&actual, 0, sizeof(actual));
+    if (getsockname(sock, (struct sockaddr *)&actual, &length) != 0)
+        sockLoopbackFailure(sock, "getsockname", WSAGetLastError());
+    address = ntohl(actual.sin_addr.s_addr);
+    if (length != (int)sizeof(actual) || actual.sin_family != AF_INET
+            || (address & 0xff000000UL) != 0x7f000000UL
+            || actual.sin_addr.s_addr != local.sin_addr.s_addr
+            || !actual.sin_port || (local.sin_port && actual.sin_port != local.sin_port))
+        sockLoopbackFailure(sock, "bound endpoint verification", WSAEINVAL);
+    if (getsockopt(sock, SOL_SOCKET, SO_TYPE, (char *)&socket_type, &type_length) != 0)
+        sockLoopbackFailure(sock, "getsockopt(SO_TYPE)", WSAGetLastError());
+    if (type_length != (int)sizeof(socket_type)
+            || (socket_type != SOCK_STREAM && socket_type != SOCK_DGRAM))
+        sockLoopbackFailure(sock, "socket type verification", WSAEINVAL);
+    fprintf(stdout, "\nCOH_WINE_DB_LOOPBACK_ONLY bind verified: protocol=%s address=%lu.%lu.%lu.%lu port=%u\n",
+            socket_type == SOCK_STREAM ? "tcp" : "udp",
+            (address >> 24) & 255, (address >> 16) & 255,
+            (address >> 8) & 255, address & 255, (unsigned)ntohs(actual.sin_port));
+    fflush(stdout);
+    return 1;
 }

