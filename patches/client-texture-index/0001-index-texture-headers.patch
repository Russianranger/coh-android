+/* Opt-in immutable-generation header index. Released immediately after the
+ * initial scan so live reload and later LWC stages always read current files. */
+static CohTextureHeaderIndex coh_texture_index;
+static unsigned char *coh_texture_index_data;
+static unsigned int coh_texture_index_hits, coh_texture_index_fallbacks;
+static void cohTextureIndexBegin(void)
+{
+    const char *path = getenv("COH_TEXTURE_HEADER_PACK");
+    const char *identity = getenv("COH_TEXTURE_HEADER_ID");
+    FILE *input;
+    long bytes;
+    if (!path || !identity || sizeof(TextureFileHeader) != COH_THI_TEXTURE_STRUCT_BYTES)
+        return;
+    if (!fileIsAbsolutePath(path)) return;
+    input = fileOpen(path, "rbR");
+    if (!input) return;
+    fseek(input, 0, SEEK_END);
+    bytes = ftell(input);
+    fseek(input, 0, SEEK_SET);
+    if (bytes >= 64 && bytes <= COH_THI_MAX_BYTES) {
+        coh_texture_index_data = malloc(bytes);
+        if (coh_texture_index_data && fread(coh_texture_index_data, 1, bytes, input) == bytes &&
+            cohThiParse(&coh_texture_index, coh_texture_index_data, bytes, identity)) {
+            printf("COH_TEXTURE_INDEX_V1 ready records=%u bytes=%ld\n", coh_texture_index.count, bytes);
+        } else {
+            cohThiFree(&coh_texture_index);
+            SAFE_FREE(coh_texture_index_data);
+            printf("COH_TEXTURE_INDEX_V1 invalid; ordinary texture reads retained\n");
+        }
+    }
+    fclose(input);
+}
+static void cohTextureIndexEnd(void)
+{
+    if (coh_texture_index.count)
+        printf("COH_TEXTURE_INDEX_V1 hits=%u ordinary_reads=%u\n", coh_texture_index_hits, coh_texture_index_fallbacks);
+    cohThiFree(&coh_texture_index);
+    SAFE_FREE(coh_texture_index_data);
+}
+
+/* The native fallback and all validation still run. Only duplicate reporting
+ * for the same missing texture in the same file is bounded during each stage. */
+static StashTable coh_missing_texture_diagnostics;
+static unsigned int coh_missing_texture_duplicates;
+static int coh_missing_texture_active;
+void texMissingDiagnosticBegin(void)
+{
+    const char *enabled = getenv("COH_TEXTURE_DIAGNOSTIC_DEDUP");
+    coh_missing_texture_active = enabled && strcmp(enabled, "1") == 0;
+    coh_missing_texture_duplicates = 0;
+    if (!coh_missing_texture_active) return;
+    if (!coh_missing_texture_diagnostics)
+        coh_missing_texture_diagnostics = stashTableCreateWithStringKeys(1024, StashDeepCopyKeys);
+    else stashTableClear(coh_missing_texture_diagnostics);
+}
+int texMissingDiagnosticShouldReport(const char *filename, const char *name)
+{
+    char key[2048];
+    int seen;
+    if (!coh_missing_texture_active || !filename || !name ||
+        strlen(filename) + strlen(name) + 2 >= sizeof(key)) return 1;
+    sprintf(key, "%s|%s", filename, name);
+    if (stashFindInt(coh_missing_texture_diagnostics, key, &seen)) {
+        ++coh_missing_texture_duplicates;
+        return 0;
+    }
+    if (stashGetValidElementCount(coh_missing_texture_diagnostics) < 8192)
+        stashAddInt(coh_missing_texture_diagnostics, key, 1, false);
+    return 1;
+}
+void texMissingDiagnosticEnd(const char *stage)
+{
+    if (coh_missing_texture_active)
+        printf("COH_TEXTURE_DIAGNOSTICS_V1 stage=%s duplicate_records=%u first_records=%u\n",
+            stage, coh_missing_texture_duplicates, stashGetValidElementCount(coh_missing_texture_diagnostics));
+    coh_missing_texture_active = 0;
+}
+
