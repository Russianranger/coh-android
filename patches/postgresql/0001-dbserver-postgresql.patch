+
+static bool postgresNeedsRebuild(TableInfo *table)
+{
+    ColumnInfo *old = NULL;
+    int count = sqlGetTableInfo(table->name, &old), i;
+    bool changed = count && count != table->num_columns;
+    for (i=0; count && i<count && i<table->num_columns && !changed; ++i)
+        changed = stricmp(old[i].name,table->columns[i].name) ||
+                  stricmp(old[i].data_type_name,table->columns[i].data_type_name);
+    free(old);
+    return changed;
+}
+
+static bool rebuildPostgresTable(TableInfo *table)
+{
+    ColumnInfo *old = NULL;
+    char *definition = NULL, *columns = NULL;
+    int count, i, j;
+    bool ok;
+    // Startup-only: finish every queued write/index operation before DDL.
+    sqlFifoBarrier();
+    sqlFifoFinish();
+    count = sqlGetTableInfo(table->name, &old);
+    for (i=0; i<table->num_columns; ++i) {
+        ColumnInfo *field = &table->columns[i];
+        if (i) estrConcatCharString(&definition, ",");
+        if (table->table_type == TT_CONTAINER && !stricmp(field->name, "ContainerId"))
+            estrConcatf(&definition, "%s SERIAL NOT NULL", field->name);
+        else
+            estrConcatf(&definition, "%s %s%s", field->name, field->data_type_name,
+                (!stricmp(field->name,"ContainerId") || !stricmp(field->name,"SubId")) ? " NOT NULL" : "");
+        for (j=0; j<count; ++j) {
+            if (!stricmp(field->name, old[j].name)) {
+                if (estrLength(&columns)) estrConcatCharString(&columns, ",");
+                estrConcatCharString(&columns, field->name);
+                break;
+            }
+        }
+    }
+    estrConcatf(&definition, ",PRIMARY KEY (ContainerId%s)", table->table_type==TT_SUBCONTAINER ? ",SubId" : "");
+    ok = sqlExecDdlf(DDL_REBUILDTABLE,
+        "SELECT dbo.coh_rebuild_table('dbo.%s'::regclass, '%s', '%s', %s);",
+        table->name, definition, columns, table->table_type==TT_CONTAINER ? "true" : "false");
+    free(old);
+    estrDestroy(&definition);
+    estrDestroy(&columns);
+    if (!ok)
+        FatalErrorf("PostgreSQL rebuild of %s failed; original table preserved. Fix the schema before restarting.", table->name);
+    return updateTable(table);
 }
 
