+void sqlConnFinishUnit(SqlConn conn) { sql.unit_active[conn] = false; sql_unit_on_thread = false; }
+bool sqlConnUnitFailed(SqlConn conn) { return sql.unit_state[conn][0] != 0; }
+const char *sqlConnUnitState(SqlConn conn) { return sql.unit_state[conn]; }
+
+static void sqlRecordUnitError(SQLSMALLINT kind, SQLHANDLE handle, SQLRETURN ret, SqlConn conn)
+{
+    SQLINTEGER native;
+    SQLCHAR state[6] = {0};
+    if (!sql.unit_active[conn] || sqlConnUnitFailed(conn) || ret >= 0)
+        return;
+    SQLGetDiagRecA(kind, handle, 1, state, &native, NULL, 0, NULL);
+    // Preserve the first failure; later 25P02 must not hide a retryable error.
+    strcpy(sql.unit_state[conn], state[0] ? (char *)state : "HY000");
+}
 
