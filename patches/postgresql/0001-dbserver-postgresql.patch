+void sqlConnBeginUnit(SqlConn conn)
+{
+    assert(!sql.unit_active[conn]);
+    sql.unit_state[conn][0] = 0;
+    sql.unit_active[conn] = true;
+    sql_unit_conn = conn;
+    sql_unit_on_thread = true;
