+/* States: 0=default/unbound, 1=loopback/unbound, 2=default/binding,
+ * 3=loopback/binding. CAS makes activation and the first bind mutually ordered.
+ * This library hook has no effect until an explicit startup request enables it. */
+#define COH_GAME_LOOPBACK_ENVIRONMENT "COH_GAME_LOOPBACK_ONLY"
+#define COH_GAME_LOOPBACK_ACK "COH_GAME_LOOPBACK_ONLY=1 active: IPv4 loopback binding policy"
+static volatile LONG sock_bind_policy = 0;
+
+int sockGameSetLoopbackOnlyMode(void)
+{
+    return InterlockedCompareExchange(&sock_bind_policy, 1, 0) == 0;
+}
+
+static LONG sockGameBindingPolicy(void)
+{
+    LONG policy;
+    do {
+        policy = InterlockedCompareExchange(&sock_bind_policy, 0, 0);
+    } while (InterlockedCompareExchange(&sock_bind_policy, policy | 2, policy) != policy);
+    return policy;
+}
+
+int sockGameLoopbackInit(void)
+{
+    char value[2];
+    DWORD length;
+    SetLastError(ERROR_SUCCESS);
+    length = GetEnvironmentVariableA(COH_GAME_LOOPBACK_ENVIRONMENT, value, sizeof(value));
+    if (!length && GetLastError() == ERROR_ENVVAR_NOT_FOUND)
+        return 0;
+    if (length != 1 || value[0] != '1') {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return -1;
+    }
+    if (!sockGameSetLoopbackOnlyMode()) {
+        SetLastError(ERROR_INVALID_STATE);
+        return -1;
+    }
+    fprintf(stdout, "\n%s\n", COH_GAME_LOOPBACK_ACK);
+    fflush(stdout);
+    return 1;
+}
+
+static void sockLoopbackFailure(SOCKET sock, const char *reason, int error)
+{
+    /* Some stock callers ignore sockBind failure. Never let an opted-in
+     * diagnostic continue after an unavailable or unverified listener. */
+    closesocket(sock);
+    fprintf(stderr, "COH_GAME_LOOPBACK_ONLY binding failed: %s (Windows socket error %d)\n", reason, error);
+    fflush(stderr);
+    ExitProcess(2);
+}
