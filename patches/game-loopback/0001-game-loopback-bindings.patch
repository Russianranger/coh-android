+/* Called immediately after every game client UDP socket is created, before
+ * sendto can implicitly bind it to wildcard. No extra Winsock calls in default
+ * mode, but every attempt prevents a later policy activation. */
+void sockGameBindClientUdp(SOCKET sock)
+{
+    struct sockaddr_in local;
+    LONG policy = sockGameBindingPolicy();
+    if (!(policy & 1))
+        return;
+    memset(&local, 0, sizeof(local));
+    local.sin_family = AF_INET;
+    local.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    sockBind(sock, &local);
 }
 
