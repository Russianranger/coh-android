+#if SERVER
+// ArmPort opt-in (ARMPORT_TRUSTED_BINS=1, read once), the switch of
+// ParserIsPersistNewer: with prepared bins used without their source scan,
+// nothing lists Defs or Menu, so their trees are not read ahead. A loader that
+// does scan either folder still requests its tree (fileScanAllDataDirs), and a
+// single file is still found on disk when it is opened.
+static int armportTrustedStartTrees(void)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+    {
+        const char* value = getenv("ARMPORT_TRUSTED_BINS");
+        enabled = value && value[0] == '1' && value[1] == '\0';
+    }
+    return enabled;
+}
+#endif
