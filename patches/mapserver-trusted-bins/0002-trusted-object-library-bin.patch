+// ArmPort opt-in (ARMPORT_TRUSTED_BINS=1, read once), the switch of
+// ParserIsPersistNewer applied to bin/defnames.bin.
+static int armportTrustedObjectLibrary(void)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+    {
+        const char* value = getenv("ARMPORT_TRUSTED_BINS");
+        enabled = value && value[0] == '1' && value[1] == '\0';
+    }
+    return enabled;
+}
