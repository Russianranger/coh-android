     entKillAll();
     if (!import)
     {
@@ -343,9 +385,15 @@ void groupLoadMap(char *mapname,int import,int do_beacon_reload)
         do_beacon_reload &&
         server_state.levelEditor!=1)
     {
-        loadstart_printf("loading beacons.. ");
-        beaconReload();
-        loadend_printf("done");
+        if (armportDeferredLoadTake(ARMPORT_DEFERRED_BEACONS))
