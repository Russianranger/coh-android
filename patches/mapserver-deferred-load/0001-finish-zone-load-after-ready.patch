+/* The two steps a zone start may leave until after "Server ready" (armport_deferred_load.h).
+ * Each is the load's own statements, run either during the load or by the main loop. */
+static void armportLoadBeacons(void)
+{
+    loadstart_printf("loading beacons.. ");
+    beaconReload();
+    loadend_printf("done");
+}
+
+/* After "Server ready" the doors are already gathered (dbGatherMapLinkInfo), so their beacon
+ * connections are made again, as beaconCheckBlocksNeedRebuild does after a rebuild. */
+static void armportDeferredDoBeacons(void)
+{
+    armportLoadBeacons();
+    dbDoorCreateBeaconConnections();
+}
+
+static void armportDeferredDoPhysx(void)
+{
+#if NOVODEX
+
+    loadstart_printf("Starting novodex...");
+
+    if ( nwInitializeNovodex() )
+    {
+        loadend_printf("success");
+    }
+    else
+    {
+        loadend_printf("failed");
+    }
+
+    loadstart_printf("freeing all .geo files...");
+    modelFreeAllGeoData();
+    loadend_printf("done");
+
+#endif
+}
