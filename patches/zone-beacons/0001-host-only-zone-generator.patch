+/* Host-only zone producer: the number of worker clients the orchestrator owns
+   (COH_ZONE_BEACON_WORKERS, one digit 1-8; unset means one, as for Atlas). */
+static S32 beaconHostZoneWorkerCount(void){
+    const char* value = getenv("COH_ZONE_BEACON_WORKERS");
+    
+    if(!value || !value[0]){
+        return 1;
+    }
+    if(value[1] || value[0] < '1' || value[0] > '8'){
+        FatalErrorf("COH_ZONE_BEACON_WORKERS must be one digit from 1 to 8");
+        exit(2);
+    }
+    printf("COH_ZONE_BEACON_WORKERS_V1 workers=%c\n", value[0]);
+    return value[0] - '0';
+}
