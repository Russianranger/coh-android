+/* Host-only: the one lower-case maps/city_zones/<world>/<world>.txt the driver names. */
+static const char* beaconHostZoneMap(void){
+    const char* map = getenv("COH_ZONE_BEACON_MAP");
+    size_t i, n = map ? strlen(map) : 0;
+    if(n < 24 || n > 96 || strncmp(map, "maps/city_zones/", 16) || strcmp(map + n - 4, ".txt")){
+        FatalErrorf("Host zone beacon producer requires COH_ZONE_BEACON_MAP");
+        exit(2);
+    }
+    for(i = 0; i < n; i++){
+        char c = map[i];
+        if(!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '/' || c == '.')){
+            FatalErrorf("Host zone beacon producer map is not a lower-case zone path");
+            exit(2);
+        }
+    }
+    return map;
+}
